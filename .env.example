BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app

DATABASE_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ExchangeRate-API (https://www.exchangerate-api.com) — used by Watcher Valas
EXCHANGERATE_API_KEY=

# MCP owner key — bearer token for POST /api/mcp (owner / super-admin access).
# Generate one with: node -e "console.log('mcp_'+require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to disable the MCP endpoint entirely (every request → 401).
MCP_OWNER_KEY=

# Cron secret — bearer token for GET /api/scrape/smartdeal (re-scrapes
# SmartDeal and refreshes the cached rates). Not wired to any scheduler here —
# point whatever cron you use (Vercel Cron, GitHub Actions, cron-job.org, ...)
# at that URL with header `Authorization: Bearer $CRON_SECRET`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
