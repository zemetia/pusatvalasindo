BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app

DATABASE_URL=

# Koneksi READ-ONLY untuk menjalankan SQL di rule reward/denda slip gaji.
# Pakai user `oc_pvi_reader` yang dibuat oleh `tsx sql/apply_openclaw.ts` — ia
# hanya punya SELECT atas view hv_*, tidak bisa menulis, dan tidak menyentuh
# data auth. Inilah yang membuat "SQL di dalam rule" aman: batasnya ditegakkan
# database, bukan validator di aplikasi.
# Kosong = engine MENOLAK menjalankan rule apa pun (tidak jatuh balik ke
# DATABASE_URL — fallback diam-diam justru menghapus batas ini).
DATABASE_VIEW_ONLY_URL=

# Kunci HMAC untuk menandatangani rule slip gaji. Baris rule yang disunting
# langsung lewat klien SQL akan gagal verifikasi dan ditolak engine.
# Minimal 16 karakter. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mengganti kunci ini membuat SELURUH rule perlu disimpan ulang lewat halaman Rule.
PAYROLL_RULE_SIGNING_KEY=

# Supabase Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ExchangeRate-API (https://www.exchangerate-api.com) — used by Watcher Valas
EXCHANGERATE_API_KEY=

# MCP owner key — bearer token for POST /api/mcp (owner / super-admin access).
# Generate one with: node -e "console.log('mcp_'+require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to disable the MCP endpoint entirely (every request → 401).
MCP_OWNER_KEY=

# Cron secret — bearer token for GET /api/scrape/smartdeal (re-scrapes
# SmartDeal and refreshes the cached rates). Not wired to any scheduler here —
# point whatever cron you use (Vercel Cron, GitHub Actions, cron-job.org, ...)
# at that URL with header `Authorization: Bearer $CRON_SECRET`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
