enum AttendanceStatus {
  PRESENT
  LATE
  // Kerja dari rumah — hari kerja penuh, jadi tidak dipotong dan tidak
  // dihitung sebagai pelanggaran; dibedakan dari PRESENT supaya HR bisa
  // melihat siapa yang tidak hadir fisik di cabang.
  WFH
  ABSENT
  PERMISSION
  SICK
  // Cuti resmi (berbayar) — berbeda dari PERMISSION yang izin insidental.
  LEAVE
  HOLIDAY
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  branchId          String?
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInPhotoUrl   String?
  checkOutPhotoUrl  String?
  // GPS from browser navigator.geolocation (auto-captured)
  checkInGpsLat     Float?
  checkInGpsLng     Float?
  // Second location from manual input on the form (to detect GPS spoofing)
  checkInManualLat  Float?
  checkInManualLng  Float?
  isLocationSuspect Boolean          @default(false)
  isWithDoctorNote  Boolean          @default(false)
  status            AttendanceStatus @default(PRESENT)
  notes             String?
  // Jejak koreksi manual oleh HR/atasan lewat halaman Presensi Karyawan.
  // Tanpa ini, jam masuk yang diketik orang lain tidak bisa dibedakan dari
  // jam hasil clock-in karyawan sendiri — padahal keduanya memengaruhi gaji.
  editedById        String?
  editedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user     user    @relation("AttendanceEmployee", fields: [userId], references: [id], onDelete: Cascade)
  editedBy user?   @relation("AttendanceEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId])
  @@index([branchId])
  @@index([date])
  @@index([editedById])
}
