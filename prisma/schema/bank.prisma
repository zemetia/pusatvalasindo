model BankAccount {
  id            String           @id @default(cuid())
  companyId     String
  bankName      String
  accountNumber String?
  accountName   String
  currencyId    String
  balance       Decimal          @default(0)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  company       Company          @relation(fields: [companyId], references: [id])
  currency      Currency         @relation(fields: [currencyId], references: [id])
  mutations     BankMutation[]
  dailyEntries  DailyBankEntry[]

  @@index([companyId])
}

model BankMutation {
  id            String           @id @default(cuid())
  bankAccountId String
  type          BankMutationType
  amount        Decimal
  balanceAfter  Decimal
  description   String?
  createdAt     DateTime         @default(now())
  createdBy     String?
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId, createdAt])
}

model DailyBankEntry {
  id            String            @id @default(cuid())
  bankAccountId String
  date          DateTime          @db.Date
  balance       Decimal           @default(0)
  note          String?
  createdBy     String?
  // Verifikasi H+1: saldo yang diisi hari ini baru bisa dikonfirmasi "Benar/Beda" besoknya.
  // Kalau Beda, angka penggantinya tidak langsung dipakai — masuk CorrectionRequest dulu.
  verifyStatus  DailyVerifyStatus @default(BELUM_REVIEW)
  verifyNote    String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, date])
  @@index([bankAccountId, date])
}

enum BankMutationType {
  CREDIT
  DEBIT
}
