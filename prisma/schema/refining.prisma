enum RefiningMethod {
  MILLER
  WOHLWILL
  AQUA_REGIA
}

enum RefiningBatchStatus {
  RUNNING
  COMPLETED
  FLAGGED
}

model RefiningBatch {
  id              String              @id @default(cuid())
  batchNumber     String              @unique
  sampleId        String?
  refiningMethod  RefiningMethod
  startTimestamp  DateTime            @default(now())
  estimatedDuration Int?
  inputWeight     Decimal             @db.Decimal(12, 4)
  initialPurity   Decimal             @db.Decimal(5, 2)
  outputWeight    Decimal?            @db.Decimal(12, 4)
  finalPurity     Decimal?            @db.Decimal(5, 2)
  recordedYield   Decimal?            @db.Decimal(6, 2)
  recordedLoss    Decimal?            @db.Decimal(6, 2)
  status          RefiningBatchStatus @default(RUNNING)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  sample          Sample?             @relation(fields: [sampleId], references: [id])

  @@index([status])
  @@index([startTimestamp])
  @@index([batchNumber])
  @@index([sampleId])
}
