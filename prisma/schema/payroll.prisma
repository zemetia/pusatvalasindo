// ═══════════════════════════════════════════════════════════════════════════
// PAYROLL — konversi skor KPI menjadi uang.
//
// Dipisah dari kpi.prisma dengan sengaja: modul KPI hanya menilai kinerja,
// keputusan bonus/potongan sepenuhnya milik payroll. Sumber aturannya adalah
// sheet "MATRIX BONUS" di docs/PVI Data/PERHITUNGAN KOMISI KPI_.xlsx.
// ═══════════════════════════════════════════════════════════════════════════

/// Matriks insentif untuk satu jabatan di satu PT. Menggantikan BonusMatrix.
model PayrollIncentiveMatrix {
  id           String  @id @default(cuid())
  companyId    String
  customRoleId String?
  name         String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole custom_role?           @relation(fields: [customRoleId], references: [id])
  tiers      PayrollIncentiveTier[]

  @@unique([companyId, customRoleId])
}

/// Satu baris matriks, mis. "80%-100% → bonus 250.000" atau
/// "10%-60% → potong 150.000 + wajib masuk setiap Sabtu".
model PayrollIncentiveTier {
  id       String @id @default(cuid())
  matrixId String

  /// Batas skor KPI sebagai rasio: 0.8 = 80%. Rentang inklusif di kedua ujung;
  /// urutan pencocokan dari minScore tertinggi supaya tier >120% menang duluan.
  minScore Decimal
  maxScore Decimal

  outcome PayrollIncentiveOutcome
  /// Selalu positif — arah (tambah/potong) ditentukan `outcome`.
  cashAmount Decimal?
  /// Sanksi non-uang yang menyertai tier ini ("setiap Sabtu wajib masuk").
  mandatorySaturday Boolean @default(false)
  /// Diisi untuk outcome TOP_PERFORMER: peringkat yang berhak (1 = terbaik
  /// di jabatan & PT yang sama pada periode itu).
  topRank Int?
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matrix PayrollIncentiveMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([matrixId])
}

// ───────────────────────────────────────────────────────────────────────────
// KOMPONEN GAJI TAMBAHAN
//
// Uang makan, transport, jabatan, dan BPJS sudah jadi kolom tetap di `user`
// karena dipakai semua karyawan. Komponen di bawah ini untuk sisanya — yang
// jumlah dan namanya beda-beda per PT (tunjangan pulsa, komunikasi, kacamata,
// potongan koperasi, dst.) — supaya menambah jenis tunjangan/potongan baru
// tidak perlu migrasi schema lagi.
//
// Semuanya nominal TETAP PER BULAN, sama seperti kolom tetap di atas. Tidak
// ada perhitungan pro-rata per hari hadir.
// ───────────────────────────────────────────────────────────────────────────

/// Daftar induk komponen gaji. `companyId` null = berlaku untuk semua PT.
model SalaryComponent {
  id        String              @id @default(cuid())
  companyId String?
  name      String
  kind      SalaryComponentKind
  /// Nilai yang diusulkan saat komponen dipasang ke karyawan baru; nilai
  /// sesungguhnya selalu diambil dari UserSalaryComponent.amount.
  defaultAmount Decimal?
  note          String?
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments UserSalaryComponent[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Nilai komponen untuk satu karyawan. Tanpa baris ini komponen tidak ikut
/// dihitung, jadi daftar induk boleh berisi komponen yang belum dipakai.
model UserSalaryComponent {
  id          String  @id @default(cuid())
  userId      String
  componentId String
  /// Selalu positif — arah (tambah/potong) ditentukan `component.kind`.
  amount Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([userId])
  @@index([componentId])
}

enum SalaryComponentKind {
  /// Menambah gaji kotor (mis. tunjangan pulsa, alokasi BPJS tambahan).
  ALLOWANCE
  /// Mengurangi gaji diterima (mis. potongan koperasi, cicilan seragam).
  DEDUCTION
}

enum PayrollIncentiveOutcome {
  /// Dapat bonus tunai sebesar cashAmount.
  BONUS_CASH
  /// Tidak dapat bonus, tidak kena potongan.
  SAFE_ZONE
  /// Kena potongan gaji sebesar cashAmount.
  DEDUCTION
  /// Bonus tambahan untuk peringkat teratas, di luar tier reguler.
  TOP_PERFORMER
}
