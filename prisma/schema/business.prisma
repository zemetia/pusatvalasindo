model Branch {
  id                String          @id @default(cuid())
  name              String
  address           String?
  phone             String?
  isActive          Boolean         @default(true)
  companyId         String?
  // Geofence for attendance check-in validation
  latitude          Float?
  longitude         Float?
  attendanceRadiusM Int?            @default(20)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company?        @relation(fields: [companyId], references: [id])
  currencyStocks    CurrencyStock[]
  stockItems        StockItem[]
  stockMutations    StockMutation[]
  users             user[]
  attendances       Attendance[]
}

model Company {
  id                        String                          @id @default(cuid())
  name                      String                          @unique
  code                      String                          @unique
  isActive                  Boolean                         @default(true)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  incentiveMatrices         PayrollIncentiveMatrix[]
  salaryComponents          SalaryComponent[]
  branches                  Branch[]
  roleKpis                  RoleKpi[]
  custom_roles              custom_role[]
  stockistPockets           StockistPocket[]
  kasPockets                KasPocket[]
  companyStockItems         CompanyStockItem[]
  bankAccounts              BankAccount[]
  stockistHeadConfirmations StockistHeadConfirmation[]
  stockistTotalHeadConfirms StockistTotalHeadConfirmation[]
  kasHeadConfirmations      KasHeadConfirmation[]
  bankHeadConfirmations     BankHeadConfirmation[]
  headConfirmationTotals    CompanyHeadConfirmationTotal[]
  correctionRequests        CorrectionRequest[]
}

model Currency {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  symbol         String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bankAccounts   BankAccount[]
  stocks         CurrencyStock[]
  stockMutations StockMutation[]
  price          CurrencyPrice?
}

// Harga Valas: harga beli & jual yang benar-benar dipakai Pusat Valas Indo hari
// ini, diisi manual per mata uang. Beda dengan PriceBenchmark yang menyimpan
// *aturan* penyesuaian di atas kurs SmartDeal — di sini yang disimpan adalah
// angka rupiahnya langsung, jadi harga tetap ada meski scraper SmartDeal mati.
// Global (bukan per cabang/PT), sama seperti PriceBenchmark: satu daftar harga
// yang berlaku untuk seluruh perusahaan.
model CurrencyPrice {
  id           String      @id @default(cuid())
  currencyId   String      @unique
  // Harga kita MEMBELI valas dari nasabah, dalam IDR per 1 unit mata uang.
  buyPrice     Decimal     @db.Decimal(18, 4)
  // Harga kita MENJUAL valas ke nasabah, dalam IDR per 1 unit mata uang.
  sellPrice    Decimal     @db.Decimal(18, 4)
  // Dari mana angka yang sekarang berasal. Dipakai UI untuk menandai baris dan
  // untuk menyusun ringkasan hasil sync.
  source       PriceSource @default(MANUAL)
  // Gembok baris. SATU-SATUNYA hal yang melindungi harga dari ditimpa sync —
  // mengedit manual saja tidak melindungi (lihat currency-price-sync.service).
  isLocked     Boolean     @default(false)
  lastSyncedAt DateTime?
  note         String?
  updatedBy    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  currency     Currency    @relation(fields: [currencyId], references: [id], onDelete: Cascade)
}

enum PriceSource {
  MANUAL
  SYNCED
}

// Saklar auto-sync Harga Valas. Tabel satu baris (`id` selalu "singleton"):
// konsumennya cuma satu dan field-nya jelas, jadi tidak dibuat tabel key-value
// generik yang nilainya tak bertipe.
model CurrencyPriceSyncSetting {
  id             String   @id @default("singleton")
  // Saat true, setiap kurs SmartDeal baru yang masuk langsung disalurkan ke
  // Harga Valas lewat aturan Patokan Harga.
  autoSync       Boolean  @default(false)
  lastRunAt      DateTime?
  /// Ringkasan sekali jalan, mis. "24 diperbarui · 3 terkunci · 1 dilewati".
  lastRunSummary String?
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

// Patokan Harga: manual sell/buy adjustment rules layered on top of the live
// SmartDeal rate (see watcher-valas.service.ts) to derive Pusat Valas Indo's
// own posted rate. Global — not branch/company-scoped. Adjustment strings are
// stored as-is (e.g. "+5", "-10", "c5", "f0.05", "c0.1+5") and parsed by
// src/lib/price-adjustment.ts; this table only persists them.
model PriceBenchmark {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  sellAdjustment String   @default("")
  buyAdjustment  String   @default("")
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Cache of SmartDeal's live counter rates, refreshed by an external
// scheduler hitting src/app/api/scrape/smartdeal/route.ts (see also
// src/lib/smartdeal-scraper.ts). Pages read from here instead of scraping
// smartdeal.co.id on every request — keeps page loads fast and gives a
// last-known-good fallback if the scrape fails.
model SmartdealRate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  buy       Float
  sell      Float
  // Value this row held immediately before the current write — lets the UI
  // show which currencies moved since the last cron fetch. Null until the
  // second cron run for a code (nothing to compare against on the first).
  prevBuy   Float?
  prevSell  Float?
  fetchedAt DateTime @default(now())
}
