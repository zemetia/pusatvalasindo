enum AttendanceStatus {
  PRESENT
  LATE
  // Kerja dari rumah — hari kerja penuh, jadi tidak dipotong dan tidak
  // dihitung sebagai pelanggaran; dibedakan dari PRESENT supaya HR bisa
  // melihat siapa yang tidak hadir fisik di cabang.
  WFH
  ABSENT
  PERMISSION
  SICK
  // Cuti resmi (berbayar) — berbeda dari PERMISSION yang izin insidental.
  LEAVE
  HOLIDAY
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  branchId          String?
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInPhotoUrl   String?
  checkOutPhotoUrl  String?
  // GPS from browser navigator.geolocation (auto-captured)
  checkInGpsLat     Float?
  checkInGpsLng     Float?
  // Second location from manual input on the form (to detect GPS spoofing)
  checkInManualLat  Float?
  checkInManualLng  Float?
  isLocationSuspect Boolean          @default(false)
  isWithDoctorNote  Boolean          @default(false)
  status            AttendanceStatus @default(PRESENT)
  notes             String?
  // Jejak koreksi manual oleh HR/atasan lewat halaman Presensi Karyawan.
  // Tanpa ini, jam masuk yang diketik orang lain tidak bisa dibedakan dari
  // jam hasil clock-in karyawan sendiri — padahal keduanya memengaruhi gaji.
  editedById        String?
  editedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user     user    @relation("AttendanceEmployee", fields: [userId], references: [id], onDelete: Cascade)
  editedBy user?   @relation("AttendanceEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId])
  @@index([branchId])
  @@index([date])
  @@index([editedById])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model custom_role {
  id                String                   @id @default(cuid())
  name              String
  description       String?
  companyId         String?
  permissions       String[]
  payrollCompanyIds String[]                 @default([])
  /// True setelah jabatan ini dipindahkan ke matriks izin per-resource.
  /// Penanda ini WAJIB eksplisit, tidak boleh disimpulkan dari "punya baris
  /// RoleResourcePermission atau tidak": mencabut seluruh izin sebuah jabatan
  /// menyisakan nol baris, dan tanpa penanda ini akses lamanya akan hidup lagi.
  usesResourcePerms Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  incentiveMatrices PayrollIncentiveMatrix[]
  roleKpis          RoleKpi[]
  company           Company?                 @relation(fields: [companyId], references: [id])
  users             user[]
  // Izin per-resource dengan scope PT terpisah untuk baca & tulis.
  // `permissions` di atas adalah model lama yang masih dibaca selama migrasi
  // bertahap (lihat src/lib/authz/resolve.ts).
  resourcePerms     RoleResourcePermission[]

  @@unique([name, companyId])
}

model user {
  id                 String                @id
  name               String
  email              String                @unique
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  phone              String?
  branchId           String?
  baseSalary         Decimal?
  mealAllowance      Decimal?
  transportAllowance Decimal?
  positionAllowance  Decimal?
  bpjsKesehatan      Decimal?
  joinDate           DateTime?
  isActive           Boolean               @default(true)
  customRoleId       String?
  kpiEntries         KpiEntry[]            @relation("KpiEntryEmployee")
  kpiEntriesCreated  KpiEntry[]            @relation("KpiEntryCreatedBy")
  kpiEntriesReviewed KpiEntry[]            @relation("KpiEntryReviewedBy")
  kpiPeriods         KpiPeriod[]           @relation("KpiPeriodEmployee")
  kpiPeriodsLocked   KpiPeriod[]           @relation("KpiPeriodLockedBy")
  kpiMonthlyResults  KpiMonthlyResult[]
  salaryComponents   UserSalaryComponent[]
  attendances        Attendance[]          @relation("AttendanceEmployee")
  attendancesEdited  Attendance[]          @relation("AttendanceEditedBy")
  samples            Sample[]
  account            account[]
  session            session[]
  branch             Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customRole         custom_role?          @relation(fields: [customRoleId], references: [id])

  @@index([branchId])
  @@index([customRoleId])
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ─── Authorization: per-resource, per-PT scope ───────────────────────────────
// Menggantikan `custom_role.permissions: String[]` yang flat (satu izin = satu
// string, tanpa dimensi PT). Model ini memisahkan dua hal yang dulu tercampur:
//
//   1. RESOURCE  — apa yang boleh diakses (satu halaman + service/API di baliknya)
//   2. SCOPE     — PT mana saja yang berlaku, terpisah untuk baca dan tulis
//
// Karena `custom_role` sudah unique([name, companyId]), "Role A di PT A" dan
// "Role A di PT B" adalah dua baris role berbeda — jadi izin per-PT-per-role
// jatuh keluar dari model ini tanpa kolom tambahan.

enum ScopeMode {
  /// Tidak punya akses sama sekali. Halaman disembunyikan dari sidebar,
  /// API mengembalikan 403. Ini juga arti dari "tidak ada baris sama sekali".
  NONE
  /// Hanya PT milik role itu sendiri (custom_role.companyId).
  OWN
  /// Daftar PT eksplisit di kolom *CompanyIds.
  SELECTED
  /// Semua PT aktif.
  ALL
}

model RoleResourcePermission {
  id       String @id @default(cuid())
  roleId   String
  /// Kunci resource dari registry di src/lib/authz/resources.ts.
  /// Sengaja String, bukan enum DB: menambah halaman baru tidak boleh butuh migrasi.
  resource String

  viewScope      ScopeMode @default(NONE)
  /// Hanya dibaca saat viewScope = SELECTED.
  viewCompanyIds String[]  @default([])

  writeScope      ScopeMode @default(NONE)
  /// Hanya dibaca saat writeScope = SELECTED.
  writeCompanyIds String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role custom_role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@index([roleId])
}

model BankAccount {
  id            String           @id @default(cuid())
  companyId     String
  bankName      String
  accountNumber String?
  accountName   String
  currencyId    String
  balance       Decimal          @default(0)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  company       Company          @relation(fields: [companyId], references: [id])
  currency      Currency         @relation(fields: [currencyId], references: [id])
  mutations     BankMutation[]
  dailyEntries  DailyBankEntry[]

  @@index([companyId])
}

model BankMutation {
  id            String           @id @default(cuid())
  bankAccountId String
  type          BankMutationType
  amount        Decimal
  balanceAfter  Decimal
  description   String?
  createdAt     DateTime         @default(now())
  createdBy     String?
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId, createdAt])
}

model DailyBankEntry {
  id            String            @id @default(cuid())
  bankAccountId String
  date          DateTime          @db.Date
  balance       Decimal           @default(0)
  note          String?
  createdBy     String?
  // Verifikasi H+1: saldo yang diisi hari ini baru bisa dikonfirmasi "Benar/Beda" besoknya.
  // Kalau Beda, angka penggantinya tidak langsung dipakai — masuk CorrectionRequest dulu.
  verifyStatus  DailyVerifyStatus @default(BELUM_REVIEW)
  verifyNote    String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, date])
  @@index([bankAccountId, date])
}

enum BankMutationType {
  CREDIT
  DEBIT
}

model Branch {
  id                String          @id @default(cuid())
  name              String
  address           String?
  phone             String?
  isActive          Boolean         @default(true)
  companyId         String?
  // Geofence for attendance check-in validation
  latitude          Float?
  longitude         Float?
  attendanceRadiusM Int?            @default(20)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company?        @relation(fields: [companyId], references: [id])
  currencyStocks    CurrencyStock[]
  stockItems        StockItem[]
  stockMutations    StockMutation[]
  users             user[]
  attendances       Attendance[]
}

model Company {
  id                        String                          @id @default(cuid())
  name                      String                          @unique
  code                      String                          @unique
  isActive                  Boolean                         @default(true)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  incentiveMatrices         PayrollIncentiveMatrix[]
  salaryComponents          SalaryComponent[]
  branches                  Branch[]
  roleKpis                  RoleKpi[]
  custom_roles              custom_role[]
  stockistPockets           StockistPocket[]
  kasPockets                KasPocket[]
  companyStockItems         CompanyStockItem[]
  bankAccounts              BankAccount[]
  stockistHeadConfirmations StockistHeadConfirmation[]
  stockistTotalHeadConfirms StockistTotalHeadConfirmation[]
  kasHeadConfirmations      KasHeadConfirmation[]
  bankHeadConfirmations     BankHeadConfirmation[]
  headConfirmationTotals    CompanyHeadConfirmationTotal[]
  correctionRequests        CorrectionRequest[]
  heldFunds                 HeldFund[]
}

model Currency {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  symbol         String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bankAccounts   BankAccount[]
  stocks         CurrencyStock[]
  stockMutations StockMutation[]
  price          CurrencyPrice?
}

// Harga Valas: harga beli & jual yang benar-benar dipakai Pusat Valas Indo hari
// ini, diisi manual per mata uang. Beda dengan PriceBenchmark yang menyimpan
// *aturan* penyesuaian di atas kurs SmartDeal — di sini yang disimpan adalah
// angka rupiahnya langsung, jadi harga tetap ada meski scraper SmartDeal mati.
// Global (bukan per cabang/PT), sama seperti PriceBenchmark: satu daftar harga
// yang berlaku untuk seluruh perusahaan.
model CurrencyPrice {
  id           String      @id @default(cuid())
  currencyId   String      @unique
  // Harga kita MEMBELI valas dari nasabah, dalam IDR per 1 unit mata uang.
  buyPrice     Decimal     @db.Decimal(18, 4)
  // Harga kita MENJUAL valas ke nasabah, dalam IDR per 1 unit mata uang.
  sellPrice    Decimal     @db.Decimal(18, 4)
  // Dari mana angka yang sekarang berasal. Dipakai UI untuk menandai baris dan
  // untuk menyusun ringkasan hasil sync.
  source       PriceSource @default(MANUAL)
  // Gembok baris. SATU-SATUNYA hal yang melindungi harga dari ditimpa sync —
  // mengedit manual saja tidak melindungi (lihat currency-price-sync.service).
  isLocked     Boolean     @default(false)
  lastSyncedAt DateTime?
  note         String?
  updatedBy    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  currency     Currency    @relation(fields: [currencyId], references: [id], onDelete: Cascade)
}

enum PriceSource {
  MANUAL
  SYNCED
}

// Saklar auto-sync Harga Valas. Tabel satu baris (`id` selalu "singleton"):
// konsumennya cuma satu dan field-nya jelas, jadi tidak dibuat tabel key-value
// generik yang nilainya tak bertipe.
model CurrencyPriceSyncSetting {
  id             String    @id @default("singleton")
  // Saat true, setiap kurs SmartDeal baru yang masuk langsung disalurkan ke
  // Harga Valas lewat aturan Patokan Harga.
  autoSync       Boolean   @default(false)
  lastRunAt      DateTime?
  /// Ringkasan sekali jalan, mis. "24 diperbarui · 3 terkunci · 1 dilewati".
  lastRunSummary String?
  updatedBy      String?
  updatedAt      DateTime  @updatedAt
}

// Patokan Harga: manual sell/buy adjustment rules layered on top of the live
// SmartDeal rate (see watcher-valas.service.ts) to derive Pusat Valas Indo's
// own posted rate. Global — not branch/company-scoped. Adjustment strings are
// stored as-is (e.g. "+5", "-10", "c5", "f0.05", "c0.1+5") and parsed by
// src/lib/price-adjustment.ts; this table only persists them.
model PriceBenchmark {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  sellAdjustment String   @default("")
  buyAdjustment  String   @default("")
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Cache of SmartDeal's live counter rates, refreshed by an external
// scheduler hitting src/app/api/scrape/smartdeal/route.ts (see also
// src/lib/smartdeal-scraper.ts). Pages read from here instead of scraping
// smartdeal.co.id on every request — keeps page loads fast and gives a
// last-known-good fallback if the scrape fails.
model SmartdealRate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  buy       Float
  sell      Float
  // Value this row held immediately before the current write — lets the UI
  // show which currencies moved since the last cron fetch. Null until the
  // second cron run for a code (nothing to compare against on the first).
  prevBuy   Float?
  prevSell  Float?
  fetchedAt DateTime @default(now())
}

// Stock Management (PT): mata uang & logam mulia yang dimiliki 1 PT (Company) secara
// langsung — bukan per cabang. Item ditulis manual (nama + kode bebas), terpisah dari
// module stock lama (StockItem, per-branch) dan dari Stockist (pocket-based).
model CompanyStockItem {
  id        String               @id @default(cuid())
  companyId String
  name      String
  code      String?
  type      CompanyStockItemType @default(CURRENCY)
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  stockistBalances          StockistBalance[]
  stockistMutations         StockistMutation[]
  stockistDailyChecks       StockistDailyCheck[]
  stockistHeadConfirmations StockistHeadConfirmation[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum CompanyStockItemType {
  CURRENCY
  LOGAM_MULIA
}

enum StockItemType {
  CURRENCY
  GOLD
  CASH
  SILVER
}

// ═══════════════════════════════════════════════════════════════════════════
// KPI — penilaian kinerja karyawan.
//
// Modul ini SENGAJA independen dari payroll: keluarannya hanya SKOR (rasio
// pencapaian tertimbang, 0..maxAchievement). Konversi skor menjadi bonus,
// potongan, atau kewajiban masuk Sabtu ada di payroll.prisma
// (PayrollIncentiveMatrix) dan dihitung oleh payroll.service.
//
// Struktur mengikuti sheet KPI perusahaan (docs/PVI Data/PUSAT KPI SEMUA_.xlsx):
//   KpiDefinition  = katalog "Key Results" beserta cara menilainya
//   RoleKpi        = penerapan satu KPI ke satu jabatan di satu PT + bobotnya
//   KpiEntry       = catatan kejadian HARIAN, digulung ke minggu 1-4 lalu bulan
//   KpiMonthlyResult = hasil akhir bulan yang sudah dibekukan
// ═══════════════════════════════════════════════════════════════════════════

/// Katalog KPI. Satu definisi bisa dipakai banyak jabatan/PT dengan bobot dan
/// parameter berbeda — parameter angkanya ada di RoleKpi, bukan di sini.
model KpiDefinition {
  id          String  @id @default(cuid())
  /// Slug stabil (mis. "omzet", "complain-nasabah"). Dipakai seed & integrasi
  /// modul lain supaya tidak bergantung pada nama yang bisa berubah.
  code        String  @unique
  name        String
  /// Kolom "Objective" pada sheet KPI, mis. "Meningkatkan Pelayanan Kepada Customer".
  objective   String?
  /// Penjelasan aturan mainnya untuk karyawan, mis. "-3 poin setiap kesalahan hitung".
  description String?

  scoringType KpiScoringType
  unit        KpiUnit        @default(OCCURRENCE)
  direction   KpiDirection   @default(HIGHER_BETTER)

  // ── Kebijakan pengisian (default; bisa ditimpa per jabatan di RoleKpi) ──
  /// Siapa yang boleh mencatat. SELF = karyawan sendiri, SUPERVISOR = hanya
  /// atasan/HR, SYSTEM = diisi otomatis modul lain (tidak bisa diinput manual).
  defaultInputSource      KpiInputSource @default(SUPERVISOR)
  /// Entri berstatus PENDING dulu dan baru dihitung setelah atasan menyetujui.
  defaultRequiresApproval Boolean        @default(true)
  /// Wajib melampirkan bukti (foto/tautan) saat mencatat.
  defaultRequiresEvidence Boolean        @default(false)

  /// Kunci kolektor otomatis untuk defaultInputSource = SYSTEM
  /// (mis. "OMZET_BRANCH", "ATTENDANCE_LATE"). Null untuk KPI manual.
  systemSourceKey String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleKpis RoleKpi[]

  @@index([isActive])
}

/// Penerapan satu KpiDefinition ke satu jabatan di satu PT: bobot + seluruh
/// angka penilaiannya. Semua entri KPI menunjuk ke baris ini (bukan ke
/// definisi), sehingga dua KPI bertipe target pada jabatan yang sama punya
/// kolam data masing-masing.
model RoleKpi {
  id           String  @id @default(cuid())
  companyId    String
  customRoleId String?
  kpiId        String

  /// Bobot 0..1. Total seluruh KPI aktif satu jabatan idealnya = 1.
  weight Decimal @default(0)

  // ── Parameter penilaian (yang dipakai tergantung scoringType) ──
  /// TARGET_VALUE & REWARD_POINT: nilai/poin yang harus dicapai sebulan.
  targetValue    Decimal?
  /// PENALTY_POINT & TOLERANCE_LIMIT: poin awal sebelum dikurangi (default 100).
  basePoint      Decimal?           @default(100)
  /// Poin (atau persen untuk PENALTY_PERCENT) per satu kejadian.
  pointPerUnit   Decimal?
  /// TOLERANCE_LIMIT: ambang yang masih ditoleransi, mis. selisih kas 100.000.
  toleranceLimit Decimal?
  /// Cakupan perhitungan toleransi.
  toleranceScope KpiToleranceScope? @default(DAILY)
  /// Plafon pencapaian, 1.2 = maksimal 120%. Menahan satu KPI menutupi KPI lain.
  maxAchievement Decimal            @default(1.2)
  /// Lantai pencapaian; 0 = nilai tidak pernah negatif.
  minAchievement Decimal            @default(0)

  // ── Override kebijakan pengisian (null = ikut KpiDefinition) ──
  inputSource      KpiInputSource?
  requiresApproval Boolean?
  requiresEvidence Boolean?

  /// Parameter kolektor otomatis, dipakai hanya bila definisinya bersumber
  /// SYSTEM. Bentuknya berbeda tiap systemSourceKey — lihat
  /// src/lib/kpi-collectors.ts. Contoh untuk ATTENDANCE_CLOSING:
  /// `{ "deadline": "05:15", "graceMinutes": 60 }`. Disimpan per jabatan
  /// karena batas jam closing berbeda antar PT (PVI 05.15, PTU 05.00).
  systemConfig Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole custom_role?  @relation(fields: [customRoleId], references: [id])
  definition KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  entries    KpiEntry[]

  @@unique([companyId, customRoleId, kpiId])
  @@index([companyId, customRoleId])
}

/// Satu catatan kejadian KPI pada satu TANGGAL. Semua tipe penilaian memakai
/// tabel ini: `quantity` berarti jumlah kejadian (penalti/reward), nilai rupiah
/// (omzet), atau besaran selisih (toleransi kas) sesuai unit definisinya.
/// Menggantikan KpiLog + Revenue yang lama.
model KpiEntry {
  id         String @id @default(cuid())
  employeeId String
  roleKpiId  String

  /// Tanggal kejadian sebenarnya — bukan tanggal input. Periode & minggu
  /// diturunkan darinya saat menyimpan agar bisa difilter tanpa hitung ulang.
  occurredAt  DateTime @db.Date
  periodYear  Int
  periodMonth Int
  /// Minggu ke-1..5 dalam bulan (mengikuti kolom "week 1-4" di sheet KPI).
  weekOfMonth Int

  quantity    Decimal
  note        String?
  evidenceUrl String?

  source KpiInputSource
  /// PENDING hanya terjadi bila KPI-nya menuntut persetujuan; entri dari
  /// atasan/sistem langsung APPROVED. Hanya APPROVED yang masuk perhitungan.
  status KpiEntryStatus @default(APPROVED)

  /// Null berarti entri dihasilkan kolektor otomatis — tidak ada manusia yang
  /// mencatatnya, dan mengarang penulis akan merusak jejak audit.
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   user    @relation("KpiEntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy  user?   @relation("KpiEntryCreatedBy", fields: [createdById], references: [id])
  reviewedBy user?   @relation("KpiEntryReviewedBy", fields: [reviewedById], references: [id])
  roleKpi    RoleKpi @relation(fields: [roleKpiId], references: [id], onDelete: Cascade)

  @@index([employeeId, periodYear, periodMonth])
  @@index([roleKpiId, periodYear, periodMonth])
  @@index([status, employeeId])
  @@index([occurredAt])
}

/// Status periode penilaian per karyawan. Setelah LOCKED, entri periode itu
/// tidak bisa ditambah/diubah/dihapus sehingga skor yang sudah dipakai payroll
/// tidak berubah di belakang layar.
model KpiPeriod {
  id         String          @id @default(cuid())
  employeeId String
  month      Int
  year       Int
  status     KpiPeriodStatus @default(OPEN)
  lockedAt   DateTime?
  lockedById String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee user  @relation("KpiPeriodEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  lockedBy user? @relation("KpiPeriodLockedBy", fields: [lockedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([year, month, status])
}

/// Hasil perhitungan sebulan. Tidak menyimpan nominal bonus/denda — itu urusan
/// payroll. `totalScore` adalah rasio tertimbang (1 = 100% target tercapai).
model KpiMonthlyResult {
  id            String   @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  totalScore    Decimal
  /// A/B/C/D hasil pemetaan totalScore, disimpan agar riwayat tidak berubah
  /// kalau ambang grade suatu saat disetel ulang.
  grade         String   @default("D")
  breakdownJson Json
  calculatedAt  DateTime @default(now())

  employee user @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId, year, month])
}

/// Cara sebuah KPI dinilai. Setiap varian punya rumusnya sendiri di
/// src/lib/kpi-scoring.ts.
enum KpiScoringType {
  /// Realisasi dibagi target. Untuk omzet, net profit margin, jumlah briefing.
  TARGET_VALUE
  /// Mulai dari basePoint, tiap kejadian mengurangi pointPerUnit.
  /// Mis. "-3 poin setiap kesalahan hitung".
  PENALTY_POINT
  /// Mulai dari 0, tiap kejadian menambah pointPerUnit, dibagi targetValue.
  /// Mis. "1 Google review = +2 poin, target 50 poin".
  REWARD_POINT
  /// Mulai 100%, tiap kejadian memotong pointPerUnit persen.
  /// Mis. "-5% setiap kali telat update kurs".
  PENALTY_PERCENT
  /// Ada ambang yang ditoleransi per hari/minggu/bulan; yang melampaui kena
  /// pointPerUnit. Mis. "selisih kas maks 100rb/hari, lebih dari itu -4 poin".
  TOLERANCE_LIMIT
  /// Rasio hari patuh terhadap hari tercatat. Untuk checklist harian
  /// (quantity 1 = patuh, 0 = tidak).
  BOOLEAN_DAILY
}

enum KpiUnit {
  OCCURRENCE
  CURRENCY
  POINT
  PERCENT
  DAY
  PERSON
}

enum KpiDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum KpiInputSource {
  SELF
  SUPERVISOR
  SYSTEM
}

enum KpiEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KpiPeriodStatus {
  OPEN
  LOCKED
}

enum KpiToleranceScope {
  DAILY
  WEEKLY
  MONTHLY
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// PAYROLL — konversi skor KPI menjadi uang.
//
// Dipisah dari kpi.prisma dengan sengaja: modul KPI hanya menilai kinerja,
// keputusan bonus/potongan sepenuhnya milik payroll. Sumber aturannya adalah
// sheet "MATRIX BONUS" di docs/PVI Data/PERHITUNGAN KOMISI KPI_.xlsx.
// ═══════════════════════════════════════════════════════════════════════════

/// Matriks insentif untuk satu jabatan di satu PT. Menggantikan BonusMatrix.
model PayrollIncentiveMatrix {
  id           String  @id @default(cuid())
  companyId    String
  customRoleId String?
  name         String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole custom_role?           @relation(fields: [customRoleId], references: [id])
  tiers      PayrollIncentiveTier[]

  @@unique([companyId, customRoleId])
}

/// Satu baris matriks, mis. "80%-100% → bonus 250.000" atau
/// "10%-60% → potong 150.000 + wajib masuk setiap Sabtu".
model PayrollIncentiveTier {
  id       String @id @default(cuid())
  matrixId String

  /// Batas skor KPI sebagai rasio: 0.8 = 80%. Rentang inklusif di kedua ujung;
  /// urutan pencocokan dari minScore tertinggi supaya tier >120% menang duluan.
  minScore Decimal
  maxScore Decimal

  outcome           PayrollIncentiveOutcome
  /// Selalu positif — arah (tambah/potong) ditentukan `outcome`.
  cashAmount        Decimal?
  /// Sanksi non-uang yang menyertai tier ini ("setiap Sabtu wajib masuk").
  mandatorySaturday Boolean                 @default(false)
  /// Diisi untuk outcome TOP_PERFORMER: peringkat yang berhak (1 = terbaik
  /// di jabatan & PT yang sama pada periode itu).
  topRank           Int?
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matrix PayrollIncentiveMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([matrixId])
}

// ───────────────────────────────────────────────────────────────────────────
// KOMPONEN GAJI TAMBAHAN
//
// Uang makan, transport, jabatan, dan BPJS sudah jadi kolom tetap di `user`
// karena dipakai semua karyawan. Komponen di bawah ini untuk sisanya — yang
// jumlah dan namanya beda-beda per PT (tunjangan pulsa, komunikasi, kacamata,
// potongan koperasi, dst.) — supaya menambah jenis tunjangan/potongan baru
// tidak perlu migrasi schema lagi.
//
// Semuanya nominal TETAP PER BULAN, sama seperti kolom tetap di atas. Tidak
// ada perhitungan pro-rata per hari hadir.
// ───────────────────────────────────────────────────────────────────────────

/// Daftar induk komponen gaji. `companyId` null = berlaku untuk semua PT.
model SalaryComponent {
  id            String              @id @default(cuid())
  companyId     String?
  name          String
  kind          SalaryComponentKind
  /// Nilai yang diusulkan saat komponen dipasang ke karyawan baru; nilai
  /// sesungguhnya selalu diambil dari UserSalaryComponent.amount.
  defaultAmount Decimal?
  note          String?
  isActive      Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments UserSalaryComponent[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Nilai komponen untuk satu karyawan. Tanpa baris ini komponen tidak ikut
/// dihitung, jadi daftar induk boleh berisi komponen yang belum dipakai.
model UserSalaryComponent {
  id          String  @id @default(cuid())
  userId      String
  componentId String
  /// Selalu positif — arah (tambah/potong) ditentukan `component.kind`.
  amount      Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([userId])
  @@index([componentId])
}

enum SalaryComponentKind {
  /// Menambah gaji kotor (mis. tunjangan pulsa, alokasi BPJS tambahan).
  ALLOWANCE
  /// Mengurangi gaji diterima (mis. potongan koperasi, cicilan seragam).
  DEDUCTION
}

enum PayrollIncentiveOutcome {
  /// Dapat bonus tunai sebesar cashAmount.
  BONUS_CASH
  /// Tidak dapat bonus, tidak kena potongan.
  SAFE_ZONE
  /// Kena potongan gaji sebesar cashAmount.
  DEDUCTION
  /// Bonus tambahan untuk peringkat teratas, di luar tier reguler.
  TOP_PERFORMER
}

// Dana Tertahan (hutang orang ke perusahaan) — piutang harian per PT.
//
// Bentuknya sengaja BEDA dari DailyBankEntry / KasDailyEntry. Dua model itu satu
// baris per pocket per tanggal, sehingga punya `@@unique([pocketId, date])` dan
// selalu ada barisnya. Di sini tiap tanggal dimulai kosong dan barisnya ditambah
// sebanyak yang memang terjadi — jadi tidak ada kunci unik per tanggal, dan
// "tidak ada baris" adalah kondisi normal, bukan "belum diisi".
//
// Statusnya BERTAHAN melintasi tanggal: baris yang dicatat hari Senin tetap
// terhitung tertahan sampai ada yang menyatakannya lunas, mungkin seminggu
// kemudian. Karena itu total dana tertahan dijumlahkan dari SELURUH tanggal yang
// belum lunas, bukan dari tanggal yang sedang dibuka di halaman.
model HeldFund {
  id        String   @id @default(cuid())
  companyId String
  // Tanggal hutangnya tercatat — bukan tanggal jatuh tempo. Inilah tanggal yang
  // dinavigasi di halaman Dana Tertahan.
  date      DateTime @db.Date
  name      String // nama orang/pihak yang uangnya belum masuk
  amount    Decimal  @default(0)
  note      String?

  // Pelunasan menandai, tidak menghapus. Baris yang dihapus akan menghilangkan
  // fakta bahwa dananya pernah tertahan, dan laporan periode lampau justru butuh
  // fakta itu. `settledAt != null` adalah satu-satunya penanda lunas — sengaja
  // tanpa boolean terpisah supaya tidak ada dua sumber kebenaran yang bisa beda.
  settledAt DateTime?
  settledBy String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  // Halaman membaca satu PT satu tanggal; laporan membaca yang belum lunas
  // lintas tanggal. Dua index terpisah karena dua pola baca yang berbeda.
  @@index([companyId, date])
  @@index([companyId, settledAt])
}

enum RefiningMethod {
  MILLER
  WOHLWILL
  AQUA_REGIA
}

enum RefiningBatchStatus {
  RUNNING
  COMPLETED
  FLAGGED
}

model RefiningBatch {
  id                String              @id @default(cuid())
  batchNumber       String              @unique
  sampleId          String?
  refiningMethod    RefiningMethod
  startTimestamp    DateTime            @default(now())
  estimatedDuration Int?
  inputWeight       Decimal             @db.Decimal(12, 4)
  initialPurity     Decimal             @db.Decimal(5, 2)
  outputWeight      Decimal?            @db.Decimal(12, 4)
  finalPurity       Decimal?            @db.Decimal(5, 2)
  recordedYield     Decimal?            @db.Decimal(6, 2)
  recordedLoss      Decimal?            @db.Decimal(6, 2)
  status            RefiningBatchStatus @default(RUNNING)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sample Sample? @relation(fields: [sampleId], references: [id])

  @@index([status])
  @@index([startTimestamp])
  @@index([batchNumber])
  @@index([sampleId])
}

enum SampleStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AssayMethod {
  FIRE_ASSAY
  XRF
  ICP
}

model Sample {
  id           String       @id @default(cuid())
  sampleNumber String       @unique
  materialType String
  source       String?
  dateReceived DateTime     @default(now())
  initialNotes String?
  status       SampleStatus @default(RECEIVED)
  technicianId String?
  method       AssayMethod?
  assayResults String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  technician      user?           @relation(fields: [technicianId], references: [id])
  refiningBatches RefiningBatch[]

  @@index([status])
  @@index([dateReceived])
  @@index([sampleNumber])
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ShipmentProviderCode {
  JNE
  TIKI
  POS_INDONESIA
  DHL
  FEDEX
  CUSTOM
}

model ShipmentProvider {
  id            String               @id @default(cuid())
  name          String
  code          ShipmentProviderCode
  apiBaseUrl    String?
  apiKey        String?
  webhookSecret String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  shipments Shipment[]

  @@unique([code])
  @@index([isActive])
}

model Shipment {
  id                String         @id @default(cuid())
  trackingNumber    String
  providerId        String
  status            ShipmentStatus @default(PENDING)
  origin            String?
  destination       String?
  recipientName     String?
  recipientPhone    String?
  // Polymorphic reference: e.g. { referenceType: "ORDER", referenceId: "abc123" }
  referenceType     String?
  referenceId       String?
  notes             String?
  estimatedDelivery DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  provider     ShipmentProvider      @relation(fields: [providerId], references: [id])
  statusEvents ShipmentStatusEvent[]

  @@unique([trackingNumber, providerId])
  @@index([providerId])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model ShipmentStatusEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  location    String?
  eventTime   DateTime       @default(now())
  rawPayload  Json?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, eventTime])
}

model CurrencyStock {
  id         String   @id @default(cuid())
  branchId   String?
  currencyId String
  quantity   Decimal  @default(0)
  buyRate    Decimal?
  sellRate   Decimal?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([branchId, currencyId])
}

model StockMutation {
  id         String            @id @default(cuid())
  branchId   String?
  currencyId String
  type       StockMutationType
  quantity   Decimal
  rate       Decimal?
  idrValue   Decimal?
  note       String?
  createdAt  DateTime          @default(now())
  createdBy  String?
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency   Currency          @relation(fields: [currencyId], references: [id])

  @@index([branchId, currencyId, createdAt])
}

model StockItem {
  id           String            @id @default(cuid())
  branchId     String?
  name         String
  code         String?
  type         StockItemType     @default(CURRENCY)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dailyEntries DailyStockEntry[]
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([branchId, name])
  @@index([branchId])
}

model DailyStockEntry {
  id          String    @id @default(cuid())
  stockItemId String
  date        DateTime  @db.Date
  closingQty  Decimal   @default(0)
  rateIdr     Decimal?
  totalIdr    Decimal?
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  qty1        Decimal   @default(0)
  qty2        Decimal   @default(0)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([stockItemId, date])
  @@index([stockItemId, date])
}

enum StockMutationType {
  OPENING
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// Bagian 1 — Stockist (Mata Uang): stock mata uang per pocket, dimiliki 1 PT (Company) dan
// dipakai bersama oleh semua cabang di bawahnya — bukan per cabang.
model StockistPocket {
  id        String    @id @default(cuid())
  companyId String
  name      String // "Kas Kecil", "Finance Blue", "Kurir A", dst
  code      String?
  isDefault Boolean   @default(false) // pocket bawaan yang ikut ke-seed tiap PT baru
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete — pocket Total (isDefault) tidak boleh pernah diisi ini
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  balances  StockistBalance[]
  mutations StockistMutation[]
  checks    StockistDailyCheck[]

  @@unique([companyId, name])
  @@index([companyId])
}

model StockistBalance {
  id                 String   @id @default(cuid())
  pocketId           String
  companyStockItemId String
  quantity           Decimal  @default(0) // saldo berjalan (running balance) — 1 sel di matrix
  updatedAt          DateTime @updatedAt

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([pocketId, companyStockItemId])
  @@index([pocketId])
}

model StockistMutation {
  id                 String               @id @default(cuid())
  pocketId           String
  companyStockItemId String
  type               StockistMutationType
  quantity           Decimal // + atau - tergantung type
  balanceAfter       Decimal
  note               String?
  createdAt          DateTime             @default(now())
  createdBy          String?

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@index([pocketId, companyStockItemId, createdAt])
}

model StockistDailyCheck {
  id                 String              @id @default(cuid())
  pocketId           String
  companyStockItemId String
  date               DateTime            @db.Date
  status             StockistCheckStatus @default(BELUM_REVIEW)
  enteredQuantity    Decimal? // hasil opname yang diisi user untuk tanggal ini — null = belum diisi
  filledAt           DateTime? // kapan opname diisi
  filledBy           String? // siapa yang mengisi opname
  note               String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([pocketId, companyStockItemId, date])
  @@index([pocketId, date])
  @@index([date, status])
}

enum StockistMutationType {
  OPENING
  TOP_UP
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum StockistCheckStatus {
  BELUM_REVIEW
  BEDA
  BENAR
}

// Status verifikasi H+1 untuk entri harian kas & bank — sengaja dipisah dari
// StockistCheckStatus supaya kedua alur bisa berkembang sendiri-sendiri.
enum DailyVerifyStatus {
  BELUM_REVIEW
  BENAR
  BEDA
}

// Bagian 3 — Tunai (Kas): pocket kas rupiah, entitas sendiri (bukan reuse StockistPocket),
// dimiliki 1 PT (Company) sama seperti StockistPocket — bukan per cabang.
model KasPocket {
  id        String   @id @default(cuid())
  companyId String
  name      String // "Kas Besar", "Kas Operasional", dst — daftar sendiri, beda dari StockistPocket
  code      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  dailyEntries KasDailyEntry[]

  @@unique([companyId, name])
  @@index([companyId])
}

model KasDailyEntry {
  id           String            @id @default(cuid())
  kasPocketId  String
  date         DateTime          @db.Date
  balance      Decimal           @default(0) // saldo tunai hari itu — user cuma isi ini, tanpa dimensi currency
  note         String?
  createdBy    String?
  // Verifikasi H+1, sama polanya dengan StockistDailyCheck: saldo yang diisi hari ini
  // baru bisa dikonfirmasi besoknya. Angka pengganti lewat CorrectionRequest.
  verifyStatus DailyVerifyStatus @default(BELUM_REVIEW)
  verifyNote   String?
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  kasPocket KasPocket @relation(fields: [kasPocketId], references: [id])

  @@unique([kasPocketId, date])
  @@index([kasPocketId, date])
}

// Bagian 4 — Konfirmasi Kepala Cabang: hitung ulang manual kepala cabang atas total
// stock (per item), total kas, dan total bank, dibandingkan dengan total sistem hasil
// input teller dalam. Hanya kepala cabang yang bisa mengisi/melihat nilai IDR di sini.
model StockistHeadConfirmation {
  id                 String    @id @default(cuid())
  companyId          String
  companyStockItemId String
  date               DateTime  @db.Date
  confirmedQuantity  Decimal // total stock asli hasil hitung ulang kepala cabang (dalam satuan item)
  // Legacy: dulu nilai IDR diisi per item. Sekarang kepala cabang hanya mengisi satu
  // total IDR final untuk seluruh stock (lihat StockistTotalHeadConfirmation), jadi
  // kolom ini tidak lagi diisi dari UI dan dibiarkan null untuk baris baru.
  confirmedIdrValue  Decimal?
  note               String?
  confirmedBy        String?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([companyId, companyStockItemId, date])
  @@index([companyId, date])
}

// Total IDR final seluruh stock (valas + logam mulia) hasil hitung ulang kepala cabang,
// satu angka per PT per tanggal — bukan lagi per item. Kuantitas per item tetap
// dicocokkan baris per baris di StockistHeadConfirmation.
model StockistTotalHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

model KasHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

// Konfirmasi total saldo bank (semua rekening PT, gabungan) oleh kepala cabang —
// dibandingkan dengan total sistem = sum(DailyBankEntry.balance) tanggal itu.
model BankHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

model CompanyHeadConfirmationTotal {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  totalIdr  Decimal // StockistTotalHeadConfirmation + KasHeadConfirmation + BankHeadConfirmation, hari itu
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
}

// Bagian 5 — Pengajuan Koreksi: saat verifikasi H+1 (stock / kas / bank harian) angkanya
// dinyatakan tidak sesuai, angka pengganti TIDAK langsung dipakai. Dia disimpan di sini
// sebagai pengajuan dan baru mengubah data setelah disetujui Owner / Super Admin.
// Referensi target disimpan sebagai id polos (tanpa FK) + label snapshot, supaya satu tabel
// bisa melayani tiga domain tanpa kolom relasi yang saling eksklusif.
model CorrectionRequest {
  id        String               @id @default(cuid())
  companyId String
  target    CorrectionTargetType
  date      DateTime             @db.Date // tanggal data yang dikoreksi

  // Hanya kolom yang relevan dengan `target` yang diisi.
  pocketId           String? // CorrectionTargetType.STOCKIST — StockistPocket
  companyStockItemId String? // CorrectionTargetType.STOCKIST — CompanyStockItem
  kasPocketId        String? // CorrectionTargetType.KAS
  bankAccountId      String? // CorrectionTargetType.BANK

  targetLabel   String // snapshot nama target saat diajukan, mis. "Kas Kecil — USD"
  currentValue  Decimal // angka yang tersimpan saat pengajuan dibuat
  proposedValue Decimal // angka pengganti usulan
  reason        String // alasan wajib dari pengaju

  status       CorrectionStatus @default(PENDING)
  requestedBy  String?
  requestedAt  DateTime         @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([target, date])
}

enum CorrectionTargetType {
  STOCKIST
  KAS
  BANK
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}
