enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ShipmentProviderCode {
  JNE
  TIKI
  POS_INDONESIA
  DHL
  FEDEX
  CUSTOM
}

model ShipmentProvider {
  id            String               @id @default(cuid())
  name          String
