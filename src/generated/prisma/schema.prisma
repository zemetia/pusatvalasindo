model CurrencyStock {
  id         String   @id @default(cuid())
  branchId   String?
  currencyId String
  quantity   Decimal  @default(0)
  buyRate    Decimal?
  sellRate   Decimal?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([branchId, currencyId])
}

model StockMutation {
  id         String            @id @default(cuid())
  branchId   String?
  currencyId String
  type       StockMutationType
  quantity   Decimal
  rate       Decimal?
  idrValue   Decimal?
  note       String?
  createdAt  DateTime          @default(now())
  createdBy  String?
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency   Currency          @relation(fields: [currencyId], references: [id])

  @@index([branchId, currencyId, createdAt])
}

model StockItem {
  id           String            @id @default(cuid())
  branchId     String?
  name         String
  code         String?
  type         StockItemType     @default(CURRENCY)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dailyEntries DailyStockEntry[]
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([branchId, name])
  @@index([branchId])
}

model DailyStockEntry {
  id          String    @id @default(cuid())
  stockItemId String
  date        DateTime  @db.Date
  closingQty  Decimal   @default(0)
  rateIdr     Decimal?
  totalIdr    Decimal?
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  qty1        Decimal   @default(0)
  qty2        Decimal   @default(0)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([stockItemId, date])
  @@index([stockItemId, date])
}

enum StockMutationType {
  OPENING
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// Bagian 1 — Stockist (Mata Uang): stock mata uang per pocket, dimiliki 1 PT (Company) dan
// dipakai bersama oleh semua cabang di bawahnya — bukan per cabang.
model StockistPocket {
  id        String    @id @default(cuid())
  companyId String
  name      String // "Kas Kecil", "Finance Blue", "Kurir A", dst
  code      String?
  isDefault Boolean   @default(false) // pocket bawaan yang ikut ke-seed tiap PT baru
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete — pocket Total (isDefault) tidak boleh pernah diisi ini
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  balances  StockistBalance[]
  mutations StockistMutation[]
  checks    StockistDailyCheck[]

  @@unique([companyId, name])
  @@index([companyId])
}

model StockistBalance {
  id                 String   @id @default(cuid())
  pocketId           String
  companyStockItemId String
  quantity           Decimal  @default(0) // saldo berjalan (running balance) — 1 sel di matrix
  updatedAt          DateTime @updatedAt

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([pocketId, companyStockItemId])
  @@index([pocketId])
}

model StockistMutation {
  id                 String               @id @default(cuid())
  pocketId           String
  companyStockItemId String
  type               StockistMutationType
  quantity           Decimal // + atau - tergantung type
  balanceAfter       Decimal
  note               String?
  createdAt          DateTime             @default(now())
  createdBy          String?

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@index([pocketId, companyStockItemId, createdAt])
}

model StockistDailyCheck {
  id                 String              @id @default(cuid())
  pocketId           String
  companyStockItemId String
  date               DateTime            @db.Date
  status             StockistCheckStatus @default(BELUM_REVIEW)
  enteredQuantity    Decimal? // hasil opname yang diisi user untuk tanggal ini — null = belum diisi
  filledAt           DateTime? // kapan opname diisi
  filledBy           String? // siapa yang mengisi opname
  note               String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([pocketId, companyStockItemId, date])
  @@index([pocketId, date])
  @@index([date, status])
}

enum StockistMutationType {
  OPENING
  TOP_UP
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum StockistCheckStatus {
  BELUM_REVIEW
  BEDA
  BENAR
}

// Status verifikasi H+1 untuk entri harian kas & bank — sengaja dipisah dari
// StockistCheckStatus supaya kedua alur bisa berkembang sendiri-sendiri.
enum DailyVerifyStatus {
  BELUM_REVIEW
  BENAR
  BEDA
}

// Bagian 3 — Tunai (Kas): pocket kas rupiah, entitas sendiri (bukan reuse StockistPocket),
// dimiliki 1 PT (Company) sama seperti StockistPocket — bukan per cabang.
model KasPocket {
  id        String   @id @default(cuid())
  companyId String
  name      String // "Kas Besar", "Kas Operasional", dst — daftar sendiri, beda dari StockistPocket
  code      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  dailyEntries KasDailyEntry[]

  @@unique([companyId, name])
  @@index([companyId])
}

model KasDailyEntry {
  id           String            @id @default(cuid())
  kasPocketId  String
  date         DateTime          @db.Date
  balance      Decimal           @default(0) // saldo tunai hari itu — user cuma isi ini, tanpa dimensi currency
  note         String?
  createdBy    String?
  // Verifikasi H+1, sama polanya dengan StockistDailyCheck: saldo yang diisi hari ini
  // baru bisa dikonfirmasi besoknya. Angka pengganti lewat CorrectionRequest.
  verifyStatus DailyVerifyStatus @default(BELUM_REVIEW)
  verifyNote   String?
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  kasPocket KasPocket @relation(fields: [kasPocketId], references: [id])

  @@unique([kasPocketId, date])
  @@index([kasPocketId, date])
}

// Bagian 4 — Konfirmasi Kepala Cabang: hitung ulang manual kepala cabang atas total
// stock (per item), total kas, dan total bank, dibandingkan dengan total sistem hasil
// input teller dalam. Hanya kepala cabang yang bisa mengisi/melihat nilai IDR di sini.
model StockistHeadConfirmation {
  id                 String    @id @default(cuid())
  companyId          String
  companyStockItemId String
  date               DateTime  @db.Date
  confirmedQuantity  Decimal // total stock asli hasil hitung ulang kepala cabang (dalam satuan item)
  // Legacy: dulu nilai IDR diisi per item. Sekarang kepala cabang hanya mengisi satu
  // total IDR final untuk seluruh stock (lihat StockistTotalHeadConfirmation), jadi
  // kolom ini tidak lagi diisi dari UI dan dibiarkan null untuk baris baru.
  confirmedIdrValue  Decimal?
  note               String?
  confirmedBy        String?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([companyId, companyStockItemId, date])
  @@index([companyId, date])
}

// Total IDR final seluruh stock (valas + logam mulia) hasil hitung ulang kepala cabang,
// satu angka per PT per tanggal — bukan lagi per item. Kuantitas per item tetap
// dicocokkan baris per baris di StockistHeadConfirmation.
model StockistTotalHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

model KasHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

// Konfirmasi total saldo bank (semua rekening PT, gabungan) oleh kepala cabang —
// dibandingkan dengan total sistem = sum(DailyBankEntry.balance) tanggal itu.
model BankHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

model CompanyHeadConfirmationTotal {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  totalIdr  Decimal // StockistTotalHeadConfirmation + KasHeadConfirmation + BankHeadConfirmation, hari itu
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
}

// Bagian 5 — Pengajuan Koreksi: saat verifikasi H+1 (stock / kas / bank harian) angkanya
// dinyatakan tidak sesuai, angka pengganti TIDAK langsung dipakai. Dia disimpan di sini
// sebagai pengajuan dan baru mengubah data setelah disetujui Owner / Super Admin.
// Referensi target disimpan sebagai id polos (tanpa FK) + label snapshot, supaya satu tabel
// bisa melayani tiga domain tanpa kolom relasi yang saling eksklusif.
model CorrectionRequest {
  id        String               @id @default(cuid())
  companyId String
  target    CorrectionTargetType
  date      DateTime             @db.Date // tanggal data yang dikoreksi

  // Hanya kolom yang relevan dengan `target` yang diisi.
  pocketId           String? // CorrectionTargetType.STOCKIST — StockistPocket
  companyStockItemId String? // CorrectionTargetType.STOCKIST — CompanyStockItem
  kasPocketId        String? // CorrectionTargetType.KAS
  bankAccountId      String? // CorrectionTargetType.BANK

  targetLabel   String // snapshot nama target saat diajukan, mis. "Kas Kecil — USD"
  currentValue  Decimal // angka yang tersimpan saat pengajuan dibuat
  proposedValue Decimal // angka pengganti usulan
  reason        String // alasan wajib dari pengaju

  status       CorrectionStatus @default(PENDING)
  requestedBy  String?
  requestedAt  DateTime         @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([target, date])
}

enum CorrectionTargetType {
  STOCKIST
  KAS
  BANK
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Transaksi Jual & Beli Valas — satu baris per transaksi nasabah di loket.
//
// Bentuknya sengaja BEDA dari modul harian (DailyStockEntry, KasDailyEntry,
// DailyBankEntry): di sana satu baris per pocket per tanggal, di sini satu baris
// per kejadian. Tidak ada kunci unik per tanggal — nol transaksi sehari adalah
// keadaan normal, bukan "belum diisi".
//
// Sumber harganya adalah Harga Valas (`CurrencyPrice`): BUY memakai `buyPrice`
// (kita membeli dari nasabah), SELL memakai `sellPrice`. Harga itu global dan
// BERGERAK, jadi angkanya di-SNAPSHOT ke baris ini saat transaksi dibuat —
// `rate` adalah kurs yang benar-benar dipakai dan `priceRate` harga yang berlaku
// saat itu. Tanpa snapshot, laporan kemarin akan ikut berubah setiap kali harga
// hari ini disimpan.
//
// Sengaja TIDAK memutasi `CurrencyStock`/`StockMutation`: stok valas dicatat
// lewat input harian Stock & Kas (closing qty per tanggal, lalu di-cross-check).
// Kalau modul ini ikut menulis ke sana, angka stok punya dua sumber kebenaran
// yang tidak bisa direkonsiliasi. Transaksi di sini adalah catatan penjualan &
// pembelian; stok tetap milik modul stockist.
model ValasTransaction {
  id String @id @default(cuid())

  // PT wajib (sumbu scope izin), cabang opsional — mengikuti pola Branch? di
  // seluruh repo: cabang boleh dihapus tanpa menghilangkan riwayat transaksinya.
  companyId String
  branchId  String?

  // Nomor bukti yang dilihat nasabah, unik per PT. Format:
  // "{KODE_PT}/{JL|BL}/{YYMMDD}/{urut 4 digit}" — lihat generateInvoiceNo.
  invoiceNo String

  // Tanggal transaksi (date-only, UTC-midnight seperti modul harian) supaya
  // laporan per tanggal tidak bergantung zona waktu. Jam sebenarnya ada di
  // `createdAt`.
  date DateTime @db.Date

  type ValasTransactionType

  currencyId String
  // Jumlah valas yang berpindah tangan, dalam satuan mata uangnya.
  amount     Decimal  @db.Decimal(18, 4)
  // Kurs yang BENAR-BENAR dipakai (IDR per 1 unit). Boleh berbeda dari
  // `priceRate` kalau kasir menegosiasikan harga.
  rate       Decimal  @db.Decimal(18, 4)
  // Harga dari Harga Valas saat transaksi dibuat — pembanding untuk menilai
  // seberapa jauh kurs dinego. Null kalau mata uangnya belum punya harga.
  priceRate  Decimal? @db.Decimal(18, 4)
  // amount × rate, dihitung server. Disimpan supaya laporan tidak perlu
  // mengalikan ulang (dan tidak bisa berbeda dari yang tercetak di bukti).
  totalIdr   Decimal  @db.Decimal(18, 2)

  // ── Nasabah ───────────────────────────────────────────────────────────────
  // Nama selalu wajib. Identitas (jenis + nomor) wajib di atas ambang
  // IDENTITY_REQUIRED_THRESHOLD — lihat valas-transaction.service.ts.
  customerName     String
  customerPhone    String?
  customerIdType   ValasCustomerIdType?
  customerIdNumber String?
  customerAddress  String?

  paymentMethod ValasPaymentMethod @default(CASH)
  // Rekening tujuan/asal saat pembayarannya transfer. Nullable karena mayoritas
  // transaksi loket tunai.
  bankAccountId String?

  note String?

  // ── Pembatalan ────────────────────────────────────────────────────────────
  // Transaksi TIDAK pernah dihapus: bukti bernomor yang hilang dari daftar
  // adalah lubang di jejak audit. Pembatalan menandai, dan barisnya tetap
  // tampil dengan status VOID (dikeluarkan dari semua total).
  status     ValasTransactionStatus @default(COMPLETED)
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency    Currency     @relation(fields: [currencyId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@unique([companyId, invoiceNo])
  // Halaman membaca satu PT satu tanggal; laporan membaca rentang tanggal per PT.
  @@index([companyId, date])
  @@index([companyId, currencyId, date])
  @@index([branchId, date])
}

enum ValasTransactionType {
  // Perusahaan MEMBELI valas dari nasabah → pakai CurrencyPrice.buyPrice.
  BUY
  // Perusahaan MENJUAL valas ke nasabah → pakai CurrencyPrice.sellPrice.
  SELL
}

enum ValasPaymentMethod {
  CASH
  TRANSFER
}

enum ValasTransactionStatus {
  COMPLETED
  VOID
}

enum ValasCustomerIdType {
  KTP
  SIM
  PASSPORT
  KITAS
  NPWP
  LAINNYA
}
