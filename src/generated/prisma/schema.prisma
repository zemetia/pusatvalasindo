enum AttendanceStatus {
  PRESENT
  LATE
  // Kerja dari rumah — hari kerja penuh, jadi tidak dipotong dan tidak
  // dihitung sebagai pelanggaran; dibedakan dari PRESENT supaya HR bisa
  // melihat siapa yang tidak hadir fisik di cabang.
  WFH
  ABSENT
  PERMISSION
  SICK
  // Cuti resmi (berbayar) — berbeda dari PERMISSION yang izin insidental.
  LEAVE
  HOLIDAY
}

/// Tanggal merah — hari libur nasional & cuti bersama.
///
/// Ada karena alpha diturunkan dari KETIADAAN baris presensi: tanpa daftar ini,
/// setiap tanggal merah yang lewat tanpa presensi akan dihitung alpha dan
/// dipotong dari gaji. Hari Minggu tidak perlu dicatat di sini — ia sudah
/// dikecualikan dari hari kerja (lihat src/lib/workday.ts).
///
/// Berlaku untuk SEMUA PT: tanggal merah ditetapkan pemerintah, bukan per
/// perusahaan. Kalau suatu saat satu PT libur sendiri di tanggal yang bukan
/// tanggal merah, itu bukan baris di sini melainkan presensi berstatus HOLIDAY.
model PublicHoliday {
  id           String   @id @default(cuid())
  date         DateTime @unique @db.Date
  name         String
  /// Cuti bersama (bukan hari libur itu sendiri) — dibedakan hanya untuk
  /// keterangan, keduanya sama-sama bukan hari kerja.
  isJointLeave Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  branchId          String?
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInPhotoUrl   String?
  checkOutPhotoUrl  String?
  // GPS from browser navigator.geolocation (auto-captured)
  checkInGpsLat     Float?
  checkInGpsLng     Float?
  // Second location from manual input on the form (to detect GPS spoofing)
  checkInManualLat  Float?
  checkInManualLng  Float?
  isLocationSuspect Boolean          @default(false)
  isWithDoctorNote  Boolean          @default(false)
  status            AttendanceStatus @default(PRESENT)
  notes             String?
  // Jejak koreksi manual oleh HR/atasan lewat halaman Presensi Karyawan.
  // Tanpa ini, jam masuk yang diketik orang lain tidak bisa dibedakan dari
  // jam hasil clock-in karyawan sendiri — padahal keduanya memengaruhi gaji.
  editedById        String?
  editedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user     user    @relation("AttendanceEmployee", fields: [userId], references: [id], onDelete: Cascade)
  editedBy user?   @relation("AttendanceEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId])
  @@index([branchId])
  @@index([date])
  @@index([editedById])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model custom_role {
  id                String                   @id @default(cuid())
  name              String
  description       String?
  companyId         String?
  permissions       String[]
  payrollCompanyIds String[]                 @default([])
  /// True setelah jabatan ini dipindahkan ke matriks izin per-resource.
  /// Penanda ini WAJIB eksplisit, tidak boleh disimpulkan dari "punya baris
  /// RoleResourcePermission atau tidak": mencabut seluruh izin sebuah jabatan
  /// menyisakan nol baris, dan tanpa penanda ini akses lamanya akan hidup lagi.
  usesResourcePerms Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  roleKpis          RoleKpi[]
  company           Company?                 @relation(fields: [companyId], references: [id])
  users             user[]
  // Izin per-resource dengan scope PT terpisah untuk baca & tulis.
  // `permissions` di atas adalah model lama yang masih dibaca selama migrasi
  // bertahap (lihat src/lib/authz/resolve.ts).
  resourcePerms     RoleResourcePermission[]
  payrollSlips      PayrollSlip[]

  @@unique([name, companyId])
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  phone         String?
  branchId      String?
  baseSalary    Decimal?
  joinDate      DateTime?

  /// Status ikatan kerja. Dipakai rule payroll untuk menegakkan aturan
  /// manajemen "yang masih belum di kontrak belum bisa mendapatkan bonus
  /// tambahan" — tanpa kolom ini aturan itu tidak punya data untuk dicek.
  /// Default sengaja BELUM_KONTRAK: menganggap karyawan sudah berkontrak
  /// padahal belum berarti membayar bonus yang tidak berhak.
  employmentStatus  EmploymentStatus @default(BELUM_KONTRAK)
  /// Tanggal mulai kontrak yang sedang berjalan. Null untuk BELUM_KONTRAK.
  contractStartDate DateTime?
  /// Tanggal berakhir kontrak. Null berarti tidak berbatas waktu — benar untuk
  /// PKWTT, dan pada PKWT berarti tanggal habisnya belum diisi.
  contractEndDate   DateTime?

  isActive             Boolean               @default(true)
  customRoleId         String?
  kpiEntries           KpiEntry[]            @relation("KpiEntryEmployee")
  kpiEntriesCreated    KpiEntry[]            @relation("KpiEntryCreatedBy")
  kpiEntriesReviewed   KpiEntry[]            @relation("KpiEntryReviewedBy")
  kpiPeriods           KpiPeriod[]           @relation("KpiPeriodEmployee")
  kpiPeriodsLocked     KpiPeriod[]           @relation("KpiPeriodLockedBy")
  kpiMonthlyResults    KpiMonthlyResult[]
  salaryComponents     UserSalaryComponent[]
  attendances          Attendance[]          @relation("AttendanceEmployee")
  attendancesEdited    Attendance[]          @relation("AttendanceEditedBy")
  payrollSlips         PayrollSlip[]
  payrollSlipsPaid     PayrollSlip[]         @relation("PayrollSlipPaidBy")
  payrollRunsGenerated PayrollRun[]          @relation("PayrollRunGeneratedBy")
  payrollRunsFinalized PayrollRun[]          @relation("PayrollRunFinalizedBy")
  payrollRulesCreated  PayrollRule[]         @relation("PayrollRuleCreatedBy")
  samples              Sample[]
  account              account[]
  session              session[]
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customRole           custom_role?          @relation(fields: [customRoleId], references: [id])

  @@index([branchId])
  @@index([customRoleId])
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ─── Authorization: per-resource, per-PT scope ───────────────────────────────
// Menggantikan `custom_role.permissions: String[]` yang flat (satu izin = satu
// string, tanpa dimensi PT). Model ini memisahkan dua hal yang dulu tercampur:
//
//   1. RESOURCE  — apa yang boleh diakses (satu halaman + service/API di baliknya)
//   2. SCOPE     — PT mana saja yang berlaku, terpisah untuk baca dan tulis
//
// Karena `custom_role` sudah unique([name, companyId]), "Role A di PT A" dan
// "Role A di PT B" adalah dua baris role berbeda — jadi izin per-PT-per-role
// jatuh keluar dari model ini tanpa kolom tambahan.

enum ScopeMode {
  /// Tidak punya akses sama sekali. Halaman disembunyikan dari sidebar,
  /// API mengembalikan 403. Ini juga arti dari "tidak ada baris sama sekali".
  NONE
  /// Hanya PT milik role itu sendiri (custom_role.companyId).
  OWN
  /// Daftar PT eksplisit di kolom *CompanyIds.
  SELECTED
  /// Semua PT aktif.
  ALL
}

model RoleResourcePermission {
  id       String @id @default(cuid())
  roleId   String
  /// Kunci resource dari registry di src/lib/authz/resources.ts.
  /// Sengaja String, bukan enum DB: menambah halaman baru tidak boleh butuh migrasi.
  resource String

  viewScope      ScopeMode @default(NONE)
  /// Hanya dibaca saat viewScope = SELECTED.
  viewCompanyIds String[]  @default([])

  writeScope      ScopeMode @default(NONE)
  /// Hanya dibaca saat writeScope = SELECTED.
  writeCompanyIds String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role custom_role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@index([roleId])
}

model BankAccount {
  id                String             @id @default(cuid())
  companyId         String
  bankName          String
  accountNumber     String?
  accountName       String
  currencyId        String
  balance           Decimal            @default(0)
  isActive          Boolean            @default(true)
  sortOrder         Int                @default(0)
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id])
  currency          Currency           @relation(fields: [currencyId], references: [id])
  mutations         BankMutation[]
  dailyEntries      DailyBankEntry[]
  valasTransactions ValasTransaction[]

  @@index([companyId])
}

model BankMutation {
  id            String           @id @default(cuid())
  bankAccountId String
  type          BankMutationType
  amount        Decimal
  balanceAfter  Decimal
  description   String?
  createdAt     DateTime         @default(now())
  createdBy     String?
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId, createdAt])
}

model DailyBankEntry {
  id            String            @id @default(cuid())
  bankAccountId String
  date          DateTime          @db.Date
  balance       Decimal           @default(0)
  note          String?
  createdBy     String?
  // Verifikasi H+1: saldo yang diisi hari ini baru bisa dikonfirmasi "Benar/Beda" besoknya.
  // Kalau Beda, angka penggantinya tidak langsung dipakai — masuk CorrectionRequest dulu.
  verifyStatus  DailyVerifyStatus @default(BELUM_REVIEW)
  verifyNote    String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, date])
  @@index([bankAccountId, date])
}

enum BankMutationType {
  CREDIT
  DEBIT
}

model Branch {
