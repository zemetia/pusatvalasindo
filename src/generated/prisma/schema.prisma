  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bankAccounts      BankAccount[]
  stocks            CurrencyStock[]
  stockMutations    StockMutation[]
  price             CurrencyPrice?
  valasTransactions ValasTransaction[]
}

// Harga Valas: harga beli & jual yang benar-benar dipakai Pusat Valas Indo hari
// ini, diisi manual per mata uang. Beda dengan PriceBenchmark yang menyimpan
// *aturan* penyesuaian di atas kurs SmartDeal — di sini yang disimpan adalah
// angka rupiahnya langsung, jadi harga tetap ada meski scraper SmartDeal mati.
// Global (bukan per cabang/PT), sama seperti PriceBenchmark: satu daftar harga
// yang berlaku untuk seluruh perusahaan.
model CurrencyPrice {
  id           String      @id @default(cuid())
  currencyId   String      @unique
  // Harga kita MEMBELI valas dari nasabah, dalam IDR per 1 unit mata uang.
  buyPrice     Decimal     @db.Decimal(18, 4)
  // Harga kita MENJUAL valas ke nasabah, dalam IDR per 1 unit mata uang.
  sellPrice    Decimal     @db.Decimal(18, 4)
  // Dari mana angka yang sekarang berasal. Dipakai UI untuk menandai baris dan
  // untuk menyusun ringkasan hasil sync.
  source       PriceSource @default(MANUAL)
  // Gembok baris. SATU-SATUNYA hal yang melindungi harga dari ditimpa sync —
  // mengedit manual saja tidak melindungi (lihat currency-price-sync.service).
  isLocked     Boolean     @default(false)
  lastSyncedAt DateTime?
  note         String?
  updatedBy    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  currency     Currency    @relation(fields: [currencyId], references: [id], onDelete: Cascade)
}

enum PriceSource {
  MANUAL
  SYNCED
}

// Saklar auto-sync Harga Valas. Tabel satu baris (`id` selalu "singleton"):
// konsumennya cuma satu dan field-nya jelas, jadi tidak dibuat tabel key-value
// generik yang nilainya tak bertipe.
model CurrencyPriceSyncSetting {
  id             String    @id @default("singleton")
  // Saat true, setiap kurs SmartDeal baru yang masuk langsung disalurkan ke
  // Harga Valas lewat aturan Patokan Harga.
  autoSync       Boolean   @default(false)
  lastRunAt      DateTime?
  /// Ringkasan sekali jalan, mis. "24 diperbarui · 3 terkunci · 1 dilewati".
  lastRunSummary String?
  updatedBy      String?
  updatedAt      DateTime  @updatedAt
}

// Patokan Harga: manual sell/buy adjustment rules layered on top of the live
// SmartDeal rate (see watcher-valas.service.ts) to derive Pusat Valas Indo's
// own posted rate. Global — not branch/company-scoped. Adjustment strings are
// stored as-is (e.g. "+5", "-10", "c5", "f0.05", "c0.1+5") and parsed by
// src/lib/price-adjustment.ts; this table only persists them.
model PriceBenchmark {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  sellAdjustment String   @default("")
  buyAdjustment  String   @default("")
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Cache of SmartDeal's live counter rates, refreshed by an external
// scheduler hitting src/app/api/scrape/smartdeal/route.ts (see also
// src/lib/smartdeal-scraper.ts). Pages read from here instead of scraping
// smartdeal.co.id on every request — keeps page loads fast and gives a
// last-known-good fallback if the scrape fails.
model SmartdealRate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  buy       Float
  sell      Float
  // Value this row held immediately before the current write — lets the UI
  // show which currencies moved since the last cron fetch. Null until the
  // second cron run for a code (nothing to compare against on the first).
  prevBuy   Float?
  prevSell  Float?
  fetchedAt DateTime @default(now())
}

// Health/status of the SmartDeal scrape itself, for Watcher Valas to show
// whether SmartDeal is currently reachable ("aktif"/"down") — separate from
// SmartdealRate, which only ever holds the last-known-good rates and has no
// notion of a failed attempt. Singleton table (`id` always "singleton"), same
// pattern as CurrencyPriceSyncSetting.
model SmartdealScrapeStatus {
  id              String    @id @default("singleton")
  // SmartDeal's own self-reported "Kurs diperbarui" timestamp (their
  // `LIVE_UPDATED` field) from the last successful scrape — distinct from
  // lastSuccessAt below, which is when WE last scraped successfully.
  sourceUpdatedAt DateTime?
  lastAttemptAt   DateTime?
  lastSuccessAt   DateTime?
  // Set on the most recent failed attempt, cleared on the next success —
  // non-null here means SmartDeal is currently considered "down".
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

// Stock Management (PT): mata uang & logam mulia yang dimiliki 1 PT (Company) secara
// langsung — bukan per cabang. Item ditulis manual (nama + kode bebas), terpisah dari
// module stock lama (StockItem, per-branch) dan dari Stockist (pocket-based).
model CompanyStockItem {
  id        String               @id @default(cuid())
  companyId String
  name      String
  code      String?
  type      CompanyStockItemType @default(CURRENCY)
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  stockistBalances          StockistBalance[]
  stockistMutations         StockistMutation[]
  stockistDailyChecks       StockistDailyCheck[]
  stockistHeadConfirmations StockistHeadConfirmation[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum CompanyStockItemType {
  CURRENCY
  LOGAM_MULIA
}

enum StockItemType {
  CURRENCY
  GOLD
  CASH
  SILVER
}

/// Status ikatan kerja karyawan.
///
/// Yang membedakan hanya satu hal untuk payroll: sudah terikat kontrak atau
/// belum. PKWT dan PKWTT dipisah karena masa berlakunya berbeda — PKWT punya
/// tanggal habis, PKWTT tidak.
enum EmploymentStatus {
  /// Belum diikat kontrak apa pun. Tidak berhak atas bonus tambahan.
  BELUM_KONTRAK
  /// Masa percobaan. Belum berkontrak, jadi diperlakukan sama seperti di atas.
  PROBATION
  /// Perjanjian Kerja Waktu Tertentu — kontrak dengan tanggal habis.
  PKWT
  /// Perjanjian Kerja Waktu Tidak Tertentu — karyawan tetap.
  PKWTT
}

// ═══════════════════════════════════════════════════════════════════════════
// KPI — penilaian kinerja karyawan.
//
// Modul ini SENGAJA independen dari payroll: keluarannya hanya SKOR (rasio
// pencapaian tertimbang, tanpa plafon maupun lantai). Konversi skor menjadi
// bonus, potongan, atau kewajiban masuk Sabtu ada di rule engine
// (payroll-rule.prisma), yang membacanya lewat view hv_kpi_monthly.
//
// Struktur mengikuti sheet KPI perusahaan (docs/PVI Data/PUSAT KPI SEMUA_.xlsx):
//   KpiDefinition  = katalog "Key Results" beserta cara menilainya
//   RoleKpi        = penerapan satu KPI ke satu jabatan di satu PT + bobotnya
//   KpiEntry       = catatan kejadian HARIAN, digulung ke minggu 1-4 lalu bulan
//   KpiMonthlyResult = hasil akhir bulan yang sudah dibekukan
// ═══════════════════════════════════════════════════════════════════════════

/// Katalog KPI. Satu definisi bisa dipakai banyak jabatan/PT dengan bobot dan
/// parameter berbeda — parameter angkanya ada di RoleKpi, bukan di sini.
model KpiDefinition {
  id          String  @id @default(cuid())
  /// Slug stabil (mis. "omzet", "complain-nasabah"). Dipakai seed & integrasi
  /// modul lain supaya tidak bergantung pada nama yang bisa berubah.
  code        String  @unique
  name        String
  /// Kolom "Objective" pada sheet KPI, mis. "Meningkatkan Pelayanan Kepada Customer".
  objective   String?
  /// Penjelasan aturan mainnya untuk karyawan, mis. "-3 poin setiap kesalahan hitung".
  description String?

  scoringType KpiScoringType
  unit        KpiUnit        @default(OCCURRENCE)
  direction   KpiDirection   @default(HIGHER_BETTER)

  // ── Kebijakan pengisian (default; bisa ditimpa per jabatan di RoleKpi) ──
  /// Siapa yang boleh mencatat. SELF = karyawan sendiri, SUPERVISOR = hanya
  /// atasan/HR, SYSTEM = diisi otomatis modul lain (tidak bisa diinput manual).
  defaultInputSource      KpiInputSource @default(SUPERVISOR)
  /// Entri berstatus PENDING dulu dan baru dihitung setelah atasan menyetujui.
  defaultRequiresApproval Boolean        @default(true)
  /// Wajib melampirkan bukti (foto/tautan) saat mencatat.
  defaultRequiresEvidence Boolean        @default(false)

  /// Kunci kolektor otomatis untuk defaultInputSource = SYSTEM
  /// (mis. "OMZET_BRANCH", "ATTENDANCE_LATE"). Null untuk KPI manual.
  systemSourceKey String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleKpis RoleKpi[]

  @@index([isActive])
}

/// Penerapan satu KpiDefinition ke satu jabatan di satu PT: bobot + seluruh
/// angka penilaiannya. Semua entri KPI menunjuk ke baris ini (bukan ke
/// definisi), sehingga dua KPI bertipe target pada jabatan yang sama punya
/// kolam data masing-masing.
model RoleKpi {
  id           String  @id @default(cuid())
  companyId    String
  customRoleId String?
  kpiId        String

  /// Bobot 0..1. Total seluruh KPI aktif satu jabatan idealnya = 1.
  weight Decimal @default(0)

  // ── Parameter penilaian (yang dipakai tergantung scoringType) ──
  /// TARGET_VALUE & REWARD_POINT: nilai/poin yang harus dicapai sebulan.
  targetValue    Decimal?
  /// PENALTY_POINT & TOLERANCE_LIMIT: poin awal sebelum dikurangi (default 100).
  basePoint      Decimal?           @default(100)
  /// Poin (atau persen untuk PENALTY_PERCENT) per satu kejadian.
  pointPerUnit   Decimal?
  /// TOLERANCE_LIMIT: ambang yang masih ditoleransi, mis. selisih kas 100.000.
  toleranceLimit Decimal?
  /// Cakupan perhitungan toleransi.
  toleranceScope KpiToleranceScope? @default(DAILY)

  // ── Override kebijakan pengisian (null = ikut KpiDefinition) ──
  inputSource      KpiInputSource?
  requiresApproval Boolean?
  requiresEvidence Boolean?

  /// Parameter kolektor otomatis, dipakai hanya bila definisinya bersumber
  /// SYSTEM. Bentuknya berbeda tiap systemSourceKey — lihat
  /// src/lib/kpi-collectors.ts. Contoh untuk ATTENDANCE_CLOSING:
  /// `{ "deadline": "05:15", "graceMinutes": 60 }`. Disimpan per jabatan
  /// karena batas jam closing berbeda antar PT (PVI 05.15, PTU 05.00).
  systemConfig Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole custom_role?  @relation(fields: [customRoleId], references: [id])
  definition KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  entries    KpiEntry[]

  @@unique([companyId, customRoleId, kpiId])
  @@index([companyId, customRoleId])
}

/// Satu catatan kejadian KPI pada satu TANGGAL. Semua tipe penilaian memakai
/// tabel ini: `quantity` berarti jumlah kejadian (penalti/reward), nilai rupiah
/// (omzet), atau besaran selisih (toleransi kas) sesuai unit definisinya.
/// Menggantikan KpiLog + Revenue yang lama.
model KpiEntry {
  id         String @id @default(cuid())
  employeeId String
  roleKpiId  String

  /// Tanggal kejadian sebenarnya — bukan tanggal input. Periode & minggu
  /// diturunkan darinya saat menyimpan agar bisa difilter tanpa hitung ulang.
  occurredAt  DateTime @db.Date
  periodYear  Int
  periodMonth Int
  /// Minggu ke-1..5 dalam bulan (mengikuti kolom "week 1-4" di sheet KPI).
  weekOfMonth Int

  quantity    Decimal
  note        String?
  evidenceUrl String?

  source KpiInputSource
  /// PENDING hanya terjadi bila KPI-nya menuntut persetujuan; entri dari
  /// atasan/sistem langsung APPROVED. Hanya APPROVED yang masuk perhitungan.
  status KpiEntryStatus @default(APPROVED)

  /// Null berarti entri dihasilkan kolektor otomatis — tidak ada manusia yang
  /// mencatatnya, dan mengarang penulis akan merusak jejak audit.
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   user    @relation("KpiEntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy  user?   @relation("KpiEntryCreatedBy", fields: [createdById], references: [id])
  reviewedBy user?   @relation("KpiEntryReviewedBy", fields: [reviewedById], references: [id])
  roleKpi    RoleKpi @relation(fields: [roleKpiId], references: [id], onDelete: Cascade)

  @@index([employeeId, periodYear, periodMonth])
  @@index([roleKpiId, periodYear, periodMonth])
  @@index([status, employeeId])
  @@index([occurredAt])
}

/// Status periode penilaian per karyawan. Setelah LOCKED, entri periode itu
/// tidak bisa ditambah/diubah/dihapus sehingga skor yang sudah dipakai payroll
/// tidak berubah di belakang layar.
model KpiPeriod {
  id         String          @id @default(cuid())
  employeeId String
  month      Int
  year       Int
  status     KpiPeriodStatus @default(OPEN)
  lockedAt   DateTime?
  lockedById String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee user  @relation("KpiPeriodEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  lockedBy user? @relation("KpiPeriodLockedBy", fields: [lockedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([year, month, status])
}

/// Hasil perhitungan sebulan. Tidak menyimpan nominal bonus/denda — itu urusan
/// payroll. `totalScore` adalah rasio tertimbang (1 = 100% target tercapai).
model KpiMonthlyResult {
  id            String   @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  totalScore    Decimal
  /// A/B/C/D hasil pemetaan totalScore, disimpan agar riwayat tidak berubah
  /// kalau ambang grade suatu saat disetel ulang.
  grade         String   @default("D")
  breakdownJson Json
  calculatedAt  DateTime @default(now())

  employee user @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId, year, month])
}

/// Cara sebuah KPI dinilai. Setiap varian punya rumusnya sendiri di
/// src/lib/kpi-scoring.ts.
enum KpiScoringType {
  /// Realisasi dibagi target. Untuk omzet, net profit margin, jumlah briefing.
  TARGET_VALUE
  /// Mulai dari basePoint, tiap kejadian mengurangi pointPerUnit.
  /// Mis. "-3 poin setiap kesalahan hitung".
  PENALTY_POINT
  /// Mulai dari 0, tiap kejadian menambah pointPerUnit, dibagi targetValue.
  /// Mis. "1 Google review = +2 poin, target 50 poin".
  REWARD_POINT
  /// Mulai 100%, tiap kejadian memotong pointPerUnit persen.
  /// Mis. "-5% setiap kali telat update kurs".
  PENALTY_PERCENT
  /// Ada ambang yang ditoleransi per hari/minggu/bulan; yang melampaui kena
  /// pointPerUnit. Mis. "selisih kas maks 100rb/hari, lebih dari itu -4 poin".
  TOLERANCE_LIMIT
  /// Rasio hari patuh terhadap hari tercatat. Untuk checklist harian
  /// (quantity 1 = patuh, 0 = tidak).
  BOOLEAN_DAILY
}

enum KpiUnit {
  OCCURRENCE
  CURRENCY
  POINT
  PERCENT
  DAY
  PERSON
}

enum KpiDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum KpiInputSource {
  SELF
  SUPERVISOR
  SYSTEM
}

enum KpiEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KpiPeriodStatus {
  OPEN
  LOCKED
}

enum KpiToleranceScope {
  DAILY
  WEEKLY
  MONTHLY
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// RULE REWARD & DENDA — definisi aturan slip gaji.
//
// Spesifikasi: docs/tasks/spesifikasi-rule-slip-gaji.md
// Hasil eksekusinya: payroll-run.prisma (PayrollRun / PayrollSlip / …Entry)
//
// Empat hal menentukan bentuk tabel ini, dan keempatnya disengaja:
//
// 0. ARAH UANG MILIK KONDISI, BUKAN MILIK RULE. Sebuah rule TIDAK punya tipe
//    "bonus" atau "denda". Yang menentukan menambah atau mengurangi adalah
//    TANDA nominal pada tier/guard yang cocok: positif menambah gaji, negatif
//    menguranginya. Satu rule karena itu bisa memberi bonus pada skor tinggi
//    DAN menjatuhkan potongan pada skor rendah — persis seperti sheet
//    manajemen menuliskannya dalam satu tabel.
//
//    Sebelumnya arah ditentukan kolom `type` di tingkat rule, sehingga tiap
//    jabatan butuh SEPASANG rule (bonus_kpi_* dan denda_kpi_*) yang menyalin
//    SQL, guard, dan sasaran yang sama persis — dua tempat yang harus diubah
//    bersamaan setiap kali satu band bergeser. Kolom itu dibuang pada migrasi
//    20260805040000.
//
// 1. APPEND-ONLY. Mengubah rule TIDAK pernah `UPDATE` — ia membuat baris baru
//    dengan `version` naik, dan mengisi `effectiveTo` pada versi lama. Slip
//    yang sudah dibayar merujuk `ruleKey@version`, jadi baris lama harus tetap
//    utuh apa adanya. Inilah pengganti riwayat git saat rule pindah dari file
//    ke database.
//
// 2. DITANDATANGANI. `signature` adalah HMAC-SHA256 atas seluruh isi rule —
//    termasuk tier-nya. Baris yang disunting langsung lewat klien SQL akan
//    gagal verifikasi dan DITOLAK engine, bukan dijalankan diam-diam. Yang
//    dilindungi di sini integritas, bukan kerahasiaan: isi rule memang
//    ditampilkan di halaman Rule.
//
// 3. SQL TERPISAH DARI KEBIJAKAN. `sql` hanya boleh disunting pemegang
//    capability `payroll.rules.sql`; tier, nominal, sasaran, dan masa berlaku
//    boleh disunting pemegang `payroll.rules`. Pembagiannya mengikuti siapa
//    yang berhak: SQL menentukan APA yang diukur, tier menentukan BERAPA
//    harganya.
//
// Query rule dijalankan lewat koneksi read-only (DATABASE_VIEW_ONLY_URL) yang
// hanya bisa SELECT dari view hv_*. Batas itu ditegakkan database, bukan
// sekadar validator di aplikasi.
// ═══════════════════════════════════════════════════════════════════════════

/// Satu VERSI dari sebuah rule. Baris tidak pernah diubah setelah dibuat.
model PayrollRule {
  id String @id @default(cuid())

  /// Identitas rule yang stabil sepanjang umurnya — TIDAK berubah saat versi
  /// naik. Inilah yang tersimpan di PayrollSlipEntry.ruleId.
  ruleKey String
  /// Naik setiap kali isi rule berubah. Ikut tersimpan di entri hasil.
  version Int

  /// Masa berlaku, keduanya INKLUSIF. Engine memilih versi yang berlaku pada
  /// periode yang dihitung; `effectiveTo` null berarti masih berlaku.
  ///
  /// Dua versi dengan `ruleKey` sama TIDAK BOLEH beririsan — kalau beririsan,
  /// engine tidak punya jawaban tunggal untuk "rule mana yang berlaku bulan
  /// ini". Itu ditegakkan DATABASE lewat constraint EXCLUDE
  /// `payroll_rule_no_overlap` (migrasi 20260805020000), bukan hanya oleh
  /// pemeriksaan aplikasi: pemeriksaan aplikasi bisa dilewati lewat klien SQL,
  /// impor, atau dua permintaan yang berjalan bersamaan. Prisma belum bisa
  /// menyatakan constraint EXCLUDE, jadi ia hidup di SQL migrasi — jangan
  /// dihapus saat schema ini di-regenerate.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  mode PayrollRuleMode

  /// Query pengumpul data. Hanya SELECT, hanya dari view `hv_*`.
  sql       String
  /// Kolom hasil query yang dipakai mencocokkan tier.
  tierField String

  /// Angka bernama yang dipakai formula: `{ "hari_kerja_standar": 24 }`.
  constants Json?
  /// Kondisi bebas yang dinilai SEBELUM tier, berurutan; yang pertama cocok
  /// menang dan menghentikan sisanya. Dua aksi:
  ///
  ///   • `skip`     — batalkan rule, tidak ada uang, catat alasannya:
  ///     `{ "if": "hari_tercatat == 0", "aksi": "skip", "flag": "data_kosong" }`
  ///   • `terapkan` — langsung bayarkan/potong tanpa melihat tier:
  ///     `{ "if": "berkontrak == 0", "aksi": "terapkan", "nominal": -50000,
  ///        "label": "...", "flag": "belum_berkontrak" }`
  ///
  /// `terapkan` memakai `nominal` ATAU `formula` (tepat satu), dan tandanya
  /// menentukan arah sama seperti pada tier. Ia ada karena tier hanya bisa
  /// mencocokkan RENTANG pada satu kolom; kondisi yang menyangkut kolom lain
  /// — atau menggabungkan beberapa kolom — tidak bisa dinyatakan sebagai tier.
  guards    Json?
  /// Dipakai kalau tidak ada tier yang cocok. Wajib ada — engine tidak boleh
  /// kehabisan jawaban di tengah perhitungan gaji.
  defaults  Json
  /// Sasaran rule (`for`): array grup `{ company, branch, roles }`.
  targets   Json
  /// Pengecualian (`except`). Selalu menang atas `targets`.
  excepts   Json?

  /// Keterangan untuk manusia — dasar kebijakan, sumber sheet, dst.
  note       String?
  /// Alasan perubahan pada versi INI. Bersama `version` inilah jejak yang
  /// menggantikan pesan commit.
  changeNote String?

  /// HMAC-SHA256 atas bentuk kanonik rule + tier-nya, memakai
  /// PAYROLL_RULE_SIGNING_KEY. Tidak cocok = rule ditolak.
  signature String

  createdAt   DateTime @default(now())
  createdById String?

  /// Versi yang digantikan baris ini. Rantai ini yang membuat "siapa mengubah
  /// apa, kapan" bisa ditelusuri tanpa tabel audit terpisah.
  supersedesId String? @unique

  createdBy    user?             @relation("PayrollRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supersedes   PayrollRule?      @relation("PayrollRuleVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy PayrollRule?      @relation("PayrollRuleVersion")
  tiers        PayrollRuleTier[]

  @@unique([ruleKey, version])
  @@index([ruleKey])
  @@index([effectiveFrom, effectiveTo])
}

/// Satu baris tier: rentang nilai → nominal, per_unit, atau formula.
///
/// Tabel tersendiri (bukan Json di dalam PayrollRule) karena inilah bagian
/// yang paling sering disunting manusia lewat UI — bentuknya perlu ditegakkan
/// database, bukan dipercayakan pada isi kolom Json.
model PayrollRuleTier {
  id     String @id @default(cuid())
  ruleId String

  /// Urutan tampil. Pencocokan tetap memakai min/max, bukan urutan ini —
  /// validator sudah menjamin tier tidak tumpang tindih.
  sortOrder Int

  /// Batas bawah & atas, keduanya INKLUSIF. Null = tidak terbatas di sisi itu.
  min Decimal?
  max Decimal?

  /// Tepat SATU dari ketiganya yang boleh terisi.
  ///
  /// BERTANDA. Positif menambah gaji, negatif menguranginya — inilah satu-
  /// satunya yang menentukan arah, dan berlaku untuk ketiganya (`formula` yang
  /// menghasilkan angka negatif juga mengurangi). Nol berarti tier itu memang
  /// tidak berdampak pada gaji, dan tetap ditulis sebagai tier supaya slip bisa
  /// menyatakan "skor Anda di zona aman" alih-alih diam.
  nominal Decimal?
  perUnit Decimal?
  formula String?

  /// Kolom hasil query yang dikalikan `perUnit`. Wajib menyertai perUnit.
  unitField String?

  /// Alasan yang tampil di slip gaji. Disalin apa adanya ke
  /// PayrollSlipEntry.label supaya angka dan alasannya tidak pernah berbeda.
  label String

  // ── Sanksi non-uang ──────────────────────────────────────────────────────
  //
  // Sebagian konsekuensi di sheet manajemen bukan rupiah: "setiap Sabtu wajib
  // masuk", "pemotongan 300 rb dan sp". Kalau tidak diwakili di sini, satu-
  // satunya jejaknya adalah teks pada `label` — tidak bisa difilter, tidak
  // bisa dilaporkan, dan hilang begitu labelnya diedit.
  //
  // Keduanya TIDAK memengaruhi nominal; ia menyertai tier yang cocok.

  /// Tier ini mewajibkan karyawan masuk setiap Sabtu selama periode berikutnya.
  mandatorySaturday Boolean @default(false)
  /// Tier ini disertai Surat Peringatan.
  warningLetter     Boolean @default(false)

  rule PayrollRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, sortOrder])
  @@index([ruleId])
}

enum PayrollRuleMode {
  /// Query mengembalikan satu baris; tier dicocokkan sekali.
  AGREGAT
  /// Query mengembalikan banyak baris; tiap baris dinilai lalu dijumlahkan.
  PER_BARIS
}

// ═══════════════════════════════════════════════════════════════════════════
// PAYROLL RUN — hasil eksekusi rule engine slip gaji.
//
// Spesifikasi rule: docs/tasks/spesifikasi-rule-slip-gaji.md
// Rule-nya sendiri TIDAK disimpan di sini — rule hidup sebagai file .json di
// prisma/seeds/payroll-rules/ supaya setiap perubahan kebijakan gaji melewati review
// kode dan tercatat di git. Yang disimpan di database hanya hasilnya.
//
// Prinsip yang menentukan bentuk tabel ini: slip harus bisa menjelaskan dirinya
// sendiri bertahun-tahun kemudian, tanpa perlu menjalankan ulang perhitungan.
// Karena itu setiap entri membawa `inputs` — nilai-nilai yang dipakai engine
// saat itu — bukan sekadar angka akhirnya.
// ═══════════════════════════════════════════════════════════════════════════

/// Satu eksekusi payroll untuk satu PT pada satu periode.
///
/// Boleh ada lebih dari satu run untuk periode yang sama: generate ulang
/// membuat run baru, tidak menimpa yang lama. `attempt` membedakannya. Run lama
/// tetap utuh supaya slip yang sudah dibayar masih bisa ditunjukkan apa adanya,
/// meskipun data sumbernya sudah berubah sejak itu.
model PayrollRun {
  id        String @id @default(cuid())
  companyId String

  /// Periode gaji. Disimpan sebagai rentang tanggal, bukan sekadar bulan,
  /// supaya periode gaji yang tidak mengikuti kalender (mis. 26–25) tetap bisa
  /// diwakili. `periodMonth`/`periodYear` ikut disimpan untuk pencarian.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  periodMonth Int
  periodYear  Int

  /// Nomor percobaan untuk periode yang sama. 1 = generate pertama.
  attempt Int @default(1)

  status PayrollRunStatus @default(DRAFT)

  /// Ringkasan konfigurasi yang dipakai run ini: daftar `id@versi` rule yang
  /// dievaluasi, plus hash isi file. Tanpa ini, dua run dengan angka berbeda
  /// tidak bisa dibedakan antara "datanya berubah" dan "rule-nya berubah".
  rulesetHash    String?
  rulesetVersion Json?

  generatedAt   DateTime  @default(now())
  generatedById String?
  finalizedAt   DateTime?
  finalizedById String?
  /// Terisi saat run ditandai dibayar. Setelah ini isi run tidak boleh diubah.
  paidAt        DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy user?         @relation("PayrollRunGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  finalizedBy user?         @relation("PayrollRunFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  slips       PayrollSlip[]

  @@unique([companyId, periodYear, periodMonth, attempt])
  @@index([companyId, periodYear, periodMonth])
  @@index([status])
}

enum PayrollRunStatus {
  /// Baru di-generate, masih boleh dihapus dan digenerate ulang.
  DRAFT
  /// Sudah diperiksa HR, angkanya dianggap benar.
  FINALIZED
  /// Sudah dibayar. Tidak boleh diubah lagi.
  PAID
  /// Dibatalkan — digantikan run lain untuk periode yang sama.
  VOID
}

/// Slip satu karyawan dalam satu run.
///
/// Semua kolom nominal adalah SNAPSHOT saat run dibuat. Kalau gaji pokok
/// karyawan naik bulan depan, slip bulan ini tidak ikut berubah.
model PayrollSlip {
  id     String @id @default(cuid())
  runId  String
  userId String

  /// Penempatan karyawan saat run dibuat — dipakai untuk pengelompokan laporan
  /// dan tetap benar walaupun karyawan pindah cabang setelahnya.
  branchId     String?
  customRoleId String?

  // ── Komponen tetap (snapshot dari data karyawan) ────────────────────────
  baseSalary         Decimal @default(0)
  mealAllowance      Decimal @default(0)
  transportAllowance Decimal @default(0)
  positionAllowance  Decimal @default(0)
  bpjsKesehatan      Decimal @default(0)

  // ── Ringkasan hasil rule ────────────────────────────────────────────────
  /// Total entri bertipe BONUS. Bisa negatif (bonus yang hangus sebagian).
  totalBonus     Decimal @default(0)
  /// Total entri bertipe DENDA. Disimpan positif.
  totalPenalty   Decimal @default(0)
  /// Total entri bertipe POTONGAN ditambah komponen gaji bertipe DEDUCTION.
  totalDeduction Decimal @default(0)
  /// Total komponen gaji tambahan bertipe ALLOWANCE.
  totalAllowance Decimal @default(0)

  grossPay Decimal @default(0)
  netPay   Decimal @default(0)

  /// Ada entri berstatus SKIPPED atau berflag di slip ini — perlu dilihat
  /// manusia sebelum difinalkan. Diturunkan dari entri, disimpan supaya daftar
  /// slip bisa menyaring tanpa menghitung ulang.
  needsReview Boolean @default(false)

  note String?

  /// Terisi saat slip INI ditandai dibayar — baik lewat "Bayar" per orang
  /// maupun ikut terbawa saat seluruh run dibayar sekaligus. Berbeda dari
  /// PayrollRun.paidAt: run baru berstatus PAID setelah SEMUA slipnya
  /// terbayar, sehingga karyawan bisa dibayar satu-satu tanpa menunggu yang
  /// lain.
  paidAt   DateTime?
  paidById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run        PayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  user       user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customRole custom_role?       @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  paidBy     user?              @relation("PayrollSlipPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  entries    PayrollSlipEntry[]

  @@unique([runId, userId])
  @@index([paidAt])
  @@index([runId])
  @@index([userId])
  @@index([branchId])
  @@index([needsReview])
}

/// Satu baris alasan di slip: satu rule yang dievaluasi, atau satu komponen
/// gaji tetap. Inilah yang tampil ke karyawan sebagai rincian.
///
/// Entri juga dibuat untuk rule yang TIDAK menghasilkan uang (status SKIPPED).
/// Slip harus bisa menjelaskan kenapa sebuah rule tidak jalan, bukan diam saja.
model PayrollSlipEntry {
  id     String @id @default(cuid())
  slipId String

  source PayrollEntrySource
  type   PayrollEntryType
  status PayrollEntryStatus @default(APPLIED)

  /// `id` rule dari file .json. Null untuk entri komponen gaji tetap.
  ruleId            String?
  /// `versi` rule saat run dijalankan. Bersama ruleId inilah kunci untuk
  /// menemukan kembali definisi rule di git.
  ruleVersion       Int?
  /// Komponen gaji tetap yang menjadi sumber entri, kalau source = COMPONENT.
  salaryComponentId String?

  /// Tier yang cocok, mis. "min:23" atau "min:1,max:3". Null kalau memakai
  /// `default` atau kalau rule di-skip.
  tier  String?
  /// Alasan yang tampil di slip. Disalin dari `label` tier — tidak pernah
  /// disusun ulang di sisi tampilan, supaya angka dan alasan tidak bisa
  /// berbeda.
  label String

  /// Selalu ditandatangani sesuai arah aslinya: bonus positif, denda dan
  /// potongan negatif. Ringkasan di PayrollSlip yang menormalkannya.
  amount Decimal @default(0)

  /// Semua nilai yang dipakai untuk sampai ke `amount`: kolom hasil query,
  /// konstanta rule, dan field karyawan yang dirujuk formula. Ini yang membuat
  /// slip menjelaskan dirinya sendiri, dan yang membuat generate ulang bisa
  /// dibandingkan dengan yang sudah dibayar.
  inputs    Json?
  /// Rincian per kejadian untuk rule mode per_baris (tanggal, tier, nominal).
  breakdown Json?
  /// Formula yang dievaluasi, apa adanya — supaya bisa dibaca tanpa membuka
  /// file rule. Null kalau tier memakai nominal tetap.
  formula   String?

  /// Penanda dari guard atau default, mis. "data_kosong", "butuh_review".
  flag String?

  createdAt DateTime @default(now())

  slip            PayrollSlip      @relation(fields: [slipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent? @relation(fields: [salaryComponentId], references: [id], onDelete: SetNull)

  @@index([slipId])
  @@index([ruleId])
  @@index([status])
}

enum PayrollEntrySource {
  /// Dihasilkan rule engine dari tabel PayrollRule.
  RULE
  /// Komponen gaji tetap dari UserSalaryComponent.
  COMPONENT
  /// Dihitung langsung oleh payroll.service, di luar rule engine — saat ini
  /// hanya potongan ketidakhadiran (sakit/izin/alpha). Dibedakan dari MANUAL
  /// karena tidak ada manusia yang memutuskannya, dan dari RULE karena tidak
  /// punya `ruleId` yang bisa ditelusuri ke tabel PayrollRule. Begitu potongan
  /// itu dipindahkan menjadi rule — seperti yang sudah dilakukan pada denda
  /// keterlambatan — sumber ini tidak akan dipakai lagi.
  SISTEM
  /// Penyesuaian manual oleh HR, dengan alasan tertulis di `label`.
  MANUAL
}

enum PayrollEntryType {
  BONUS
  DENDA
  POTONGAN
  TUNJANGAN
}

enum PayrollEntryStatus {
  /// Nominalnya ikut dihitung.
  APPLIED
  /// Guard kena — rule tidak menghasilkan uang, tapi tetap dicatat beserta
  /// alasannya dan masuk antrian review.
  SKIPPED
  /// Query atau formula gagal dievaluasi. Sama seperti SKIPPED tidak
  /// menghasilkan uang, tapi ini menandakan konfigurasi yang perlu diperbaiki,
  /// bukan data karyawan yang belum lengkap.
  ERROR
}

// ═══════════════════════════════════════════════════════════════════════════
// PAYROLL — komponen gaji tambahan.
//
// Dipisah dari kpi.prisma dengan sengaja: modul KPI hanya menilai kinerja,
// keputusan bonus/potongan sepenuhnya milik payroll.
//
// Konversi skor KPI menjadi rupiah SELURUHNYA ada di rule engine
// (payroll-rule.prisma). Matriks insentif lama (BonusMatrix, lalu
// PayrollIncentiveMatrix) sudah DIBUANG seluruhnya, termasuk dari riwayat
// migrasi: terlalu kaku (tier hanya bisa berpatokan pada skor KPI, nominalnya
// selalu angka tetap, sasarannya terkunci pada satu jabatan di satu PT) dan,
// selama masih hidup berdampingan dengan rule engine, hasil keduanya ikut
// dijumlahkan sehingga karyawan dibayar dua kali untuk skor yang sama.
//
// Data payroll hasil perhitungan versi lama juga dikosongkan pada migrasi
// 20260805030000 — periode gaji digenerate ulang lewat rule engine, tidak
// dikonversi.
//
// Yang tersisa di berkas ini hanya komponen gaji yang nominalnya tetap per
// bulan dan tidak bergantung pada kinerja.
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────
// KOMPONEN GAJI TAMBAHAN
//
// Uang makan, transport, jabatan, dan BPJS TIDAK LAGI kolom tetap di `user`
// (migrasi 20260806000000) — sekarang cuma 4 SalaryComponent global biasa,
// sama seperti tunjangan pulsa, komunikasi, kacamata, potongan koperasi, dst.
// Dicocokkan oleh `payrollService`/`loadEmployeeContext` lewat NAMA
// ("Uang Makan", "Uang Transport", "Uang Jabatan", "BPJS Kesehatan"), bukan id
// tetap — supaya menambah/mengubah jenis tunjangan/potongan tidak perlu
// migrasi schema lagi, dengan trade-off: rename nama komponen itu lewat
// halaman Komponen Gaji akan melepas pencocokannya.
//
// Semuanya nominal TETAP PER BULAN. Tidak ada perhitungan pro-rata per hari
// hadir.
// ───────────────────────────────────────────────────────────────────────────

/// Daftar induk komponen gaji. `companyId` null = berlaku untuk semua PT.
model SalaryComponent {
  id            String              @id @default(cuid())
  companyId     String?
  name          String
  kind          SalaryComponentKind
  /// Nilai yang diusulkan saat komponen dipasang ke karyawan baru; nilai
  /// sesungguhnya selalu diambil dari UserSalaryComponent.amount.
  defaultAmount Decimal?
  note          String?
  isActive      Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments UserSalaryComponent[]
  slipEntries PayrollSlipEntry[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Nilai komponen untuk satu karyawan. Tanpa baris ini komponen tidak ikut
/// dihitung, jadi daftar induk boleh berisi komponen yang belum dipakai.
model UserSalaryComponent {
  id          String  @id @default(cuid())
  userId      String
  componentId String
  /// Selalu positif — arah (tambah/potong) ditentukan `component.kind`.
  amount      Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([userId])
  @@index([componentId])
}

enum SalaryComponentKind {
  /// Menambah gaji kotor (mis. tunjangan pulsa, alokasi BPJS tambahan).
  ALLOWANCE
  /// Mengurangi gaji diterima (mis. potongan koperasi, cicilan seragam).
  DEDUCTION
}

// Dana Tertahan (hutang orang ke perusahaan) — piutang harian per PT.
//
// Bentuknya sengaja BEDA dari DailyBankEntry / KasDailyEntry. Dua model itu satu
// baris per pocket per tanggal, sehingga punya `@@unique([pocketId, date])` dan
// selalu ada barisnya. Di sini tiap tanggal dimulai kosong dan barisnya ditambah
// sebanyak yang memang terjadi — jadi tidak ada kunci unik per tanggal, dan
// "tidak ada baris" adalah kondisi normal, bukan "belum diisi".
//
// Statusnya BERTAHAN melintasi tanggal: baris yang dicatat hari Senin tetap
// terhitung tertahan sampai ada yang menyatakannya lunas, mungkin seminggu
// kemudian. Karena itu total dana tertahan dijumlahkan dari SELURUH tanggal yang
// belum lunas, bukan dari tanggal yang sedang dibuka di halaman.
model HeldFund {
  id        String   @id @default(cuid())
  companyId String
  // Tanggal hutangnya tercatat — bukan tanggal jatuh tempo. Inilah tanggal yang
  // dinavigasi di halaman Dana Tertahan.
  date      DateTime @db.Date
  name      String // nama orang/pihak yang uangnya belum masuk
  amount    Decimal  @default(0)
  note      String?

  // Pelunasan menandai, tidak menghapus. Baris yang dihapus akan menghilangkan
  // fakta bahwa dananya pernah tertahan, dan laporan periode lampau justru butuh
  // fakta itu. `settledAt != null` adalah satu-satunya penanda lunas — sengaja
  // tanpa boolean terpisah supaya tidak ada dua sumber kebenaran yang bisa beda.
  settledAt DateTime?
  settledBy String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  // Halaman membaca satu PT satu tanggal; laporan membaca yang belum lunas
  // lintas tanggal. Dua index terpisah karena dua pola baca yang berbeda.
  @@index([companyId, date])
  @@index([companyId, settledAt])
}

enum RefiningMethod {
  MILLER
  WOHLWILL
  AQUA_REGIA
}

enum RefiningBatchStatus {
  RUNNING
  COMPLETED
  FLAGGED
}

model RefiningBatch {
  id                String              @id @default(cuid())
  batchNumber       String              @unique
  sampleId          String?
  refiningMethod    RefiningMethod
  startTimestamp    DateTime            @default(now())
  estimatedDuration Int?
  inputWeight       Decimal             @db.Decimal(12, 4)
  initialPurity     Decimal             @db.Decimal(5, 2)
  outputWeight      Decimal?            @db.Decimal(12, 4)
  finalPurity       Decimal?            @db.Decimal(5, 2)
  recordedYield     Decimal?            @db.Decimal(6, 2)
  recordedLoss      Decimal?            @db.Decimal(6, 2)
  status            RefiningBatchStatus @default(RUNNING)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sample Sample? @relation(fields: [sampleId], references: [id])

