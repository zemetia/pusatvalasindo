enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  PERMISSION
  SICK
  HOLIDAY
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  branchId          String?
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInPhotoUrl   String?
  checkOutPhotoUrl  String?
  // GPS from browser navigator.geolocation (auto-captured)
  checkInGpsLat     Float?
  checkInGpsLng     Float?
  // Second location from manual input on the form (to detect GPS spoofing)
  checkInManualLat  Float?
  checkInManualLng  Float?
  isLocationSuspect Boolean          @default(false)
  isWithDoctorNote  Boolean          @default(false)
  status            AttendanceStatus @default(PRESENT)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user   user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId])
  @@index([branchId])
  @@index([date])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model custom_role {
  id                String        @id @default(cuid())
  name              String
  description       String?
  companyId         String?
  permissions       String[]
  payrollCompanyIds String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bonusMatrices     BonusMatrix[]
  roleKpis          RoleKpi[]
  company           Company?      @relation(fields: [companyId], references: [id])
  users             user[]

  @@unique([name, companyId])
}

model user {
  id                 String             @id
  name               String
  email              String             @unique
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  phone              String?
  branchId           String?
  baseSalary         Decimal?
  mealAllowance      Decimal?
  transportAllowance Decimal?
  positionAllowance  Decimal?
  bpjsKesehatan      Decimal?
  joinDate           DateTime?
  isActive           Boolean            @default(true)
  companyId          String?
  customRoleId       String?
  kpiLogs            KpiLog[]
  kpiMonthlyResults  KpiMonthlyResult[]
  revenues           Revenue[]
  attendances        Attendance[]
  samples            Sample[]
  account            account[]
  session            session[]
  branch             Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  company            Company?           @relation(fields: [companyId], references: [id])
  customRole         custom_role?       @relation(fields: [customRoleId], references: [id])

  @@index([branchId])
  @@index([companyId])
  @@index([customRoleId])
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model BankAccount {
  id            String           @id @default(cuid())
  companyId     String
  bankName      String
  accountNumber String?
  accountName   String
  currencyId    String
  balance       Decimal          @default(0)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  company       Company          @relation(fields: [companyId], references: [id])
  currency      Currency         @relation(fields: [currencyId], references: [id])
  mutations     BankMutation[]
  dailyEntries  DailyBankEntry[]

  @@index([companyId])
}

model BankMutation {
  id            String           @id @default(cuid())
  bankAccountId String
  type          BankMutationType
  amount        Decimal
  balanceAfter  Decimal
  description   String?
  createdAt     DateTime         @default(now())
  createdBy     String?
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId, createdAt])
}

model DailyBankEntry {
  id            String      @id @default(cuid())
  bankAccountId String
  date          DateTime    @db.Date
  balance       Decimal     @default(0)
  note          String?
  createdBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, date])
  @@index([bankAccountId, date])
}

enum BankMutationType {
  CREDIT
  DEBIT
}

model Branch {
  id                String          @id @default(cuid())
  name              String
  address           String?
  phone             String?
  isActive          Boolean         @default(true)
  companyId         String?
  // Geofence for attendance check-in validation
  latitude          Float?
  longitude         Float?
  attendanceRadiusM Int?            @default(20)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company?        @relation(fields: [companyId], references: [id])
  currencyStocks    CurrencyStock[]
  stockItems        StockItem[]
  stockMutations    StockMutation[]
  users             user[]
  attendances       Attendance[]
}

model Company {
  id                        String                         @id @default(cuid())
  name                      String                         @unique
  code                      String                         @unique
  isActive                  Boolean                        @default(true)
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  bonusMatrices             BonusMatrix[]
  branches                  Branch[]
  roleKpis                  RoleKpi[]
  custom_roles              custom_role[]
  users                     user[]
  stockistPockets           StockistPocket[]
  kasPockets                KasPocket[]
  companyStockItems         CompanyStockItem[]
  bankAccounts              BankAccount[]
  stockistHeadConfirmations StockistHeadConfirmation[]
  kasHeadConfirmations      KasHeadConfirmation[]
  headConfirmationTotals    CompanyHeadConfirmationTotal[]
}

model Currency {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  symbol         String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bankAccounts   BankAccount[]
  stocks         CurrencyStock[]
  stockMutations StockMutation[]
}

// Stock Management (PT): mata uang & logam mulia yang dimiliki 1 PT (Company) secara
// langsung — bukan per cabang. Item ditulis manual (nama + kode bebas), terpisah dari
// module stock lama (StockItem, per-branch) dan dari Stockist (pocket-based).
model CompanyStockItem {
  id        String               @id @default(cuid())
  companyId String
  name      String
  code      String?
  type      CompanyStockItemType @default(CURRENCY)
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  stockistBalances          StockistBalance[]
  stockistMutations         StockistMutation[]
  stockistDailyChecks       StockistDailyCheck[]
  stockistHeadConfirmations StockistHeadConfirmation[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum CompanyStockItemType {
  CURRENCY
  LOGAM_MULIA
}

enum StockItemType {
  CURRENCY
  GOLD
  CASH
  SILVER
}

model KpiDefinition {
  id        String    @id @default(cuid())
  name      String
  type      KpiType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  logs      KpiLog[]
  roleKpis  RoleKpi[]
}

model RoleKpi {
  id           String        @id @default(cuid())
  companyId    String
  kpiId        String
  maxScore     Decimal
  targetValue  Decimal?
  threshold    Decimal?
  weight       Decimal       @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customRoleId String?
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole   custom_role?  @relation(fields: [customRoleId], references: [id])
  definition   KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([companyId, customRoleId, kpiId])
  @@index([companyId, customRoleId])
}

model KpiLog {
  id         String        @id @default(cuid())
  employeeId String
  kpiId      String
  value      Decimal
  note       String?
  createdAt  DateTime      @default(now())
  employee   user          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  definition KpiDefinition @relation(fields: [kpiId], references: [id])

  @@index([employeeId, createdAt])
  @@index([kpiId])
}

model Revenue {
  id         String   @id @default(cuid())
  employeeId String
  amount     Decimal
  date       DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())
  employee   user     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model BonusMatrix {
  id           String       @id @default(cuid())
  companyId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customRoleId String?
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole   custom_role? @relation(fields: [customRoleId], references: [id])
  tiers        BonusTier[]

  @@unique([companyId, customRoleId])
}

model BonusTier {
  id             String          @id @default(cuid())
  matrixId       String
  minScore       Decimal
  maxScore       Decimal
  resultType     BonusResultType
  amount         Decimal?
  isTopPerformer Boolean         @default(false)
  matrix         BonusMatrix     @relation(fields: [matrixId], references: [id], onDelete: Cascade)
}

model KpiMonthlyResult {
  id            String           @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  totalScore    Decimal
  bonusAmount   Decimal?
  bonusResult   BonusResultType?
  breakdownJson Json
  calculatedAt  DateTime         @default(now())
  employee      user             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId, year, month])
}

enum KpiType {
  EVENT
  TARGET
}

enum BonusResultType {
  BONUS_CASH
  SAFE_ZONE
  PENALTY_SATURDAY
  PENALTY_DEDUCTION
  TOP_PERFORMER
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RefiningMethod {
  MILLER
  WOHLWILL
  AQUA_REGIA
}

enum RefiningBatchStatus {
  RUNNING
  COMPLETED
  FLAGGED
}

model RefiningBatch {
  id                String              @id @default(cuid())
  batchNumber       String              @unique
  sampleId          String?
  refiningMethod    RefiningMethod
  startTimestamp    DateTime            @default(now())
  estimatedDuration Int?
  inputWeight       Decimal             @db.Decimal(12, 4)
  initialPurity     Decimal             @db.Decimal(5, 2)
  outputWeight      Decimal?            @db.Decimal(12, 4)
  finalPurity       Decimal?            @db.Decimal(5, 2)
  recordedYield     Decimal?            @db.Decimal(6, 2)
  recordedLoss      Decimal?            @db.Decimal(6, 2)
  status            RefiningBatchStatus @default(RUNNING)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sample Sample? @relation(fields: [sampleId], references: [id])

  @@index([status])
  @@index([startTimestamp])
  @@index([batchNumber])
  @@index([sampleId])
}

enum SampleStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AssayMethod {
  FIRE_ASSAY
  XRF
  ICP
}

model Sample {
  id           String       @id @default(cuid())
  sampleNumber String       @unique
  materialType String
  source       String?
  dateReceived DateTime     @default(now())
  initialNotes String?
  status       SampleStatus @default(RECEIVED)
  technicianId String?
  method       AssayMethod?
  assayResults String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  technician      user?           @relation(fields: [technicianId], references: [id])
  refiningBatches RefiningBatch[]

  @@index([status])
  @@index([dateReceived])
  @@index([sampleNumber])
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ShipmentProviderCode {
  JNE
  TIKI
  POS_INDONESIA
  DHL
  FEDEX
  CUSTOM
}

model ShipmentProvider {
  id            String               @id @default(cuid())
  name          String
  code          ShipmentProviderCode
  apiBaseUrl    String?
  apiKey        String?
  webhookSecret String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  shipments Shipment[]

  @@unique([code])
  @@index([isActive])
}

model Shipment {
  id                String         @id @default(cuid())
  trackingNumber    String
  providerId        String
  status            ShipmentStatus @default(PENDING)
  origin            String?
  destination       String?
  recipientName     String?
  recipientPhone    String?
  // Polymorphic reference: e.g. { referenceType: "ORDER", referenceId: "abc123" }
  referenceType     String?
  referenceId       String?
  notes             String?
  estimatedDelivery DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  provider     ShipmentProvider      @relation(fields: [providerId], references: [id])
  statusEvents ShipmentStatusEvent[]

  @@unique([trackingNumber, providerId])
  @@index([providerId])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model ShipmentStatusEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  location    String?
  eventTime   DateTime       @default(now())
  rawPayload  Json?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, eventTime])
}

model CurrencyStock {
  id         String   @id @default(cuid())
  branchId   String?
  currencyId String
  quantity   Decimal  @default(0)
  buyRate    Decimal?
  sellRate   Decimal?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([branchId, currencyId])
}

model StockMutation {
  id         String            @id @default(cuid())
  branchId   String?
  currencyId String
  type       StockMutationType
  quantity   Decimal
  rate       Decimal?
  idrValue   Decimal?
  note       String?
  createdAt  DateTime          @default(now())
  createdBy  String?
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currency   Currency          @relation(fields: [currencyId], references: [id])

  @@index([branchId, currencyId, createdAt])
}

model StockItem {
  id           String            @id @default(cuid())
  branchId     String?
  name         String
  code         String?
  type         StockItemType     @default(CURRENCY)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dailyEntries DailyStockEntry[]
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([branchId, name])
  @@index([branchId])
}

model DailyStockEntry {
  id          String    @id @default(cuid())
  stockItemId String
  date        DateTime  @db.Date
  closingQty  Decimal   @default(0)
  rateIdr     Decimal?
  totalIdr    Decimal?
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  qty1        Decimal   @default(0)
  qty2        Decimal   @default(0)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([stockItemId, date])
  @@index([stockItemId, date])
}

enum StockMutationType {
  OPENING
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// Bagian 1 — Stockist (Mata Uang): stock mata uang per pocket, dimiliki 1 PT (Company) dan
// dipakai bersama oleh semua cabang di bawahnya — bukan per cabang.
model StockistPocket {
  id        String    @id @default(cuid())
  companyId String
  name      String // "Kas Kecil", "Finance Blue", "Kurir A", dst
  code      String?
  isDefault Boolean   @default(false) // pocket bawaan yang ikut ke-seed tiap PT baru
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete — pocket Total (isDefault) tidak boleh pernah diisi ini
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  balances  StockistBalance[]
  mutations StockistMutation[]
  checks    StockistDailyCheck[]

  @@unique([companyId, name])
  @@index([companyId])
}

model StockistBalance {
  id                 String   @id @default(cuid())
  pocketId           String
  companyStockItemId String
  quantity           Decimal  @default(0) // saldo berjalan (running balance) — 1 sel di matrix
  updatedAt          DateTime @updatedAt

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([pocketId, companyStockItemId])
  @@index([pocketId])
}

model StockistMutation {
  id                 String               @id @default(cuid())
  pocketId           String
  companyStockItemId String
  type               StockistMutationType
  quantity           Decimal // + atau - tergantung type
  balanceAfter       Decimal
  note               String?
  createdAt          DateTime             @default(now())
  createdBy          String?

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@index([pocketId, companyStockItemId, createdAt])
}

model StockistDailyCheck {
  id                 String              @id @default(cuid())
  pocketId           String
  companyStockItemId String
  date               DateTime            @db.Date
  status             StockistCheckStatus @default(BELUM_REVIEW)
  enteredQuantity    Decimal? // hasil opname yang diisi user untuk tanggal ini — null = belum diisi
  filledAt           DateTime? // kapan opname diisi
  filledBy           String? // siapa yang mengisi opname
  note               String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  pocket           StockistPocket   @relation(fields: [pocketId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([pocketId, companyStockItemId, date])
  @@index([pocketId, date])
  @@index([date, status])
}

enum StockistMutationType {
  OPENING
  TOP_UP
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum StockistCheckStatus {
  BELUM_REVIEW
  BEDA
  BENAR
}

// Bagian 3 — Tunai (Kas): pocket kas rupiah, entitas sendiri (bukan reuse StockistPocket),
// dimiliki 1 PT (Company) sama seperti StockistPocket — bukan per cabang.
model KasPocket {
  id        String   @id @default(cuid())
  companyId String
  name      String // "Kas Besar", "Kas Operasional", dst — daftar sendiri, beda dari StockistPocket
  code      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  dailyEntries KasDailyEntry[]

  @@unique([companyId, name])
  @@index([companyId])
}

model KasDailyEntry {
  id          String   @id @default(cuid())
  kasPocketId String
  date        DateTime @db.Date
  balance     Decimal  @default(0) // saldo tunai hari itu — user cuma isi ini, tanpa dimensi currency
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kasPocket KasPocket @relation(fields: [kasPocketId], references: [id])

  @@unique([kasPocketId, date])
  @@index([kasPocketId, date])
}

// Bagian 4 — Konfirmasi Kepala Cabang: hitung ulang manual kepala cabang atas total
// stock (per item) dan total kas (gabungan), dibandingkan dengan total sistem hasil
// input teller dalam. Hanya kepala cabang yang bisa mengisi/melihat nilai IDR di sini.
model StockistHeadConfirmation {
  id                 String    @id @default(cuid())
  companyId          String
  companyStockItemId String
  date               DateTime  @db.Date
  confirmedQuantity  Decimal // total stock asli hasil hitung ulang kepala cabang
  confirmedIdrValue  Decimal // total dalam IDR hasil hitung ulang kepala cabang
  note               String?
  confirmedBy        String?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  companyStockItem CompanyStockItem @relation(fields: [companyStockItemId], references: [id])

  @@unique([companyId, companyStockItemId, date])
  @@index([companyId, date])
}

model KasHeadConfirmation {
  id                String    @id @default(cuid())
  companyId         String
  date              DateTime  @db.Date
  confirmedIdrValue Decimal
  note              String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId, date])
}

model CompanyHeadConfirmationTotal {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  totalIdr  Decimal // sum(StockistHeadConfirmation.confirmedIdrValue) + KasHeadConfirmation.confirmedIdrValue, hari itu
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
}
